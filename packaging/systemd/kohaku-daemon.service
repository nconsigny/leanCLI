[Unit]
# kohaku-daemon — user-mode systemd unit for the leanKohaku JSON-RPC daemon.
#
# This unit is installed by `kohakuspawn` into
# $XDG_CONFIG_HOME/systemd/user/ (typically ~/.config/systemd/user/). It
# deliberately omits an [Install] section: starting/stopping the daemon
# is a manual lifecycle operation, not something we tie to login. The
# user runs `systemctl --user start kohaku-daemon` when they want the
# wallet up, and the autospawn paths in the CLI/TUI refuse to spawn
# while the marker file ~/.config/leankohaku/managed-by-systemd exists.
#
# The colibri light-client sidecar (bridge/colibri/bridge.mjs) is NOT a
# separate unit. The daemon spawns it as a child process with
# stderr := .inherit (see LeanKohaku/Colibri/Persistent.lean), so its
# logs land in this unit's journal automatically and KillMode=control-group
# guarantees it dies with the daemon when the unit stops.
Description=leanKohaku wallet daemon (user)
After=default.target

[Service]
Type=simple
ExecStart=%h/.kohaku/bin/kohaku-daemon

# daemon.env is auxiliary — RPC URLs and other env knobs the onboarding
# flow mirrors here so systemd-managed runs see the same config as
# shell-launched runs. daemon.json (under $XDG_CONFIG_HOME/leankohaku/)
# remains authoritative for per-chain config. The leading `-` makes the
# unit tolerant of a missing file (fresh install with no onboarding yet).
EnvironmentFile=-%h/.config/leankohaku/daemon.env

Restart=on-failure
RestartSec=2

StandardOutput=journal
StandardError=journal

# control-group + a generous TimeoutStopSec gives the colibri sidecar
# time to flush its UDS state cleanly when the unit stops. The daemon's
# own shutdown handler unlinks the socket before exiting; if it hangs,
# the 10s timeout lets systemd SIGKILL the whole cgroup.
KillMode=control-group
TimeoutStopSec=10

# Hardening — kept conservative because this is a wallet that reads its
# own config (and writes its state log) under $HOME. We intentionally do
# NOT set:
#   - ProtectSystem=strict   (would block writes to %h/.local/share)
#   - ProtectHome=yes        (would block reads of %h/.config)
#   - MemoryDenyWriteExecute (breaks Node.js — the colibri sidecar)
# The settings below are portable to user units and don't require
# CAP_SYS_ADMIN to enforce.
NoNewPrivileges=yes
PrivateTmp=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# Intentionally no [Install] section. Manual lifecycle only — no
# WantedBy, no linger, no auto-start at login. The user runs:
#   systemctl --user start kohaku-daemon
#   systemctl --user stop  kohaku-daemon
#   journalctl --user -u kohaku-daemon -f
