# leanCLI .env example
#
# Copy this to `.env` (which is gitignored), then fill in real values.
# The CLI and daemon auto-load `./.env` and `${XDG_CONFIG_HOME:-$HOME/.config}/leancli/.env`
# at startup. Real shell env always wins over .env (see LeanCli/Util/DotEnv.lean),
# so you can override per-shell with `export …` without editing the file.
#
# Disable .env autoload entirely:  LEANCLI_NO_DOTENV=1

# ---------------------------------------------------------------------------
# RPC URLs
# ---------------------------------------------------------------------------
# Default RPC used by `leancli balance`, `leancli send`, etc. when no chain is
# specified. Loopback values are treated as localNode; anything else is
# classified as configuredNode.
#LEANCLI_RPC_URL=http://127.0.0.1:8545

# Per-chain overrides. Either spelling works; LEANCLI_RPC_URL_<NAME> wins
# if both are set. `leancli network` shows the resolved values + their source.
#MAINNET_RPC_URL=https://your-mainnet-rpc.example/
#SEPOLIA_RPC_URL=https://your-sepolia-rpc.example/
#LEANCLI_RPC_URL_MAINNET=https://your-mainnet-rpc.example/
#LEANCLI_RPC_URL_SEPOLIA=https://your-sepolia-rpc.example/

# Transport classification for the default RPC. Auto-detected for loopback
# URLs; set explicitly for Tor / non-loopback configured nodes.
# Allowed: loopback | direct | tor
#LEANCLI_RPC_TRANSPORT=direct

# Optional: separate ENS resolver RPC. Falls back to LEANCLI_RPC_URL.
#LEANCLI_ENS_RPC_URL=https://your-mainnet-rpc.example/

# ---------------------------------------------------------------------------
# Daemon
# ---------------------------------------------------------------------------
# Network policy mode. Goes through LeanCli.Network.Policy.parsePolicy.
# Allowed: cli | strict | loopback-strict | tor | dev | permissive | indexer | deny
# Default: strict (chain-aware: mainnet-strict + testnet-permissive). Deny-by-default backbone.
#LEANCLI_NETWORK_POLICY=strict

# Override the Unix socket path. Default: $XDG_RUNTIME_DIR/leancli/leancli.sock
#LEANCLI_SOCKET=/tmp/leancli.sock

# Chain id the daemon reports/signs against. 1 = mainnet, 11155111 = sepolia.
#LEANCLI_CHAIN_ID=11155111

# Network request log: 1 (default) writes to .leancli/logs/, 0 disables.
#LEANCLI_NETWORK_LOG=1

# ---------------------------------------------------------------------------
# Kohaku plugin host — providers and privacy plugins
# (see docs/PLUGIN_ARCHITECTURE.md for the full surface)
# ---------------------------------------------------------------------------
# Provider = the read/simulation backend (single-select). Default: helios.
#   helios   — @a16z/helios light client + REVM; consensus-verified state.
#   colibri  — Colibri stateless light client (WASM EVM + committee proofs).
#   rpc      — direct configured RPC endpoint; no light-client verification.
#   safenode — helios fronted by the TDX-attested SafeNode ORAM proxy
#              (requires LEANCLI_SAFE_NODE_URL below).
# Changeable at runtime via `daemon.readBackend.set` and per call via `backend:`.
# LEANCLI_READ_BACKEND is a back-compat alias; LEANCLI_PROVIDER wins.
#LEANCLI_PROVIDER=helios

# Privacy plugins to enable (multi-select, comma list). Default: empty = none.
# A shielded.* call for a plugin not listed here is refused before its code loads.
# Allowed entries: railgun, privacy-pools, tornado
#LEANCLI_PRIVACY=railgun,privacy-pools

# Privacy spending secret — a SEPARATE BIP-39 mnemonic, never the EOA mnemonic.
# Required when a privacy plugin is enabled. NEVER commit a real phrase.
#LEANCLI_PP_MNEMONIC="abandon abandon abandon … art"

# SafeNode ORAM proxy (only when LEANCLI_PROVIDER=safenode).
#LEANCLI_SAFE_NODE_URL=https://your-safenode.example/
#LEANCLI_SAFE_NODE_API_KEY=
#LEANCLI_SAFE_NODE_FALLBACK_RPC=https://your-fallback-rpc.example/
