[Unit]
# leancli-daemon — user-mode systemd unit for the leanCLI JSON-RPC daemon.
#
# This unit is installed by `leanclispawn` into
# $XDG_CONFIG_HOME/systemd/user/ (typically ~/.config/systemd/user/). It
# deliberately omits an [Install] section: starting/stopping the daemon
# is a manual lifecycle operation, not something we tie to login. The
# user runs `systemctl --user start leancli-daemon` when they want the
# wallet up, and the autospawn paths in the CLI/TUI refuse to spawn
# while the marker file ~/.config/leancli/managed-by-systemd exists.
#
# Light-client sidecars (bridge/colibri/bridge.mjs and bridge/helios/bridge.mjs)
# are NOT separate units. The daemon spawns each as a child process with
# stderr := .inherit (see LeanCli/{Colibri,Helios}/Persistent.lean), so
# their logs land in this unit's journal automatically and
# KillMode=control-group guarantees they die with the daemon when the unit
# stops. Helios is opt-in via LEANCLI_HELIOS=1 in daemon.env (set by
# leanclispawn at install time); colibri is opt-out via LEANCLI_COLIBRI=0.
Description=leanCLI wallet daemon (user)
After=default.target

[Service]
Type=simple
ExecStart=%h/.leancli/bin/leancli-daemon

# daemon.env is auxiliary — RPC URLs and other env knobs the onboarding
# flow mirrors here so systemd-managed runs see the same config as
# shell-launched runs. daemon.json (under $XDG_CONFIG_HOME/leancli/)
# remains authoritative for per-chain config. The leading `-` makes the
# unit tolerant of a missing file (fresh install with no onboarding yet).
EnvironmentFile=-%h/.config/leancli/daemon.env

Restart=on-failure
RestartSec=2

StandardOutput=journal
StandardError=journal

# control-group + a generous TimeoutStopSec gives the colibri / helios
# sidecars time to flush their UDS state cleanly when the unit stops.
# The daemon's own shutdown handler unlinks both sockets before exiting;
# if it hangs, the 10s timeout lets systemd SIGKILL the whole cgroup.
KillMode=control-group
TimeoutStopSec=10

# Hardening — kept conservative because this is a wallet that reads its
# own config (and writes its state log) under $HOME. We intentionally do
# NOT set:
#   - ProtectSystem=strict   (would block writes to %h/.local/share)
#   - ProtectHome=yes        (would block reads of %h/.config)
#   - MemoryDenyWriteExecute (breaks Node.js — the colibri / helios sidecars)
# The settings below are portable to user units and don't require
# CAP_SYS_ADMIN to enforce.
NoNewPrivileges=yes
PrivateTmp=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# Intentionally no [Install] section. Manual lifecycle only — no
# WantedBy, no linger, no auto-start at login. The user runs:
#   systemctl --user start leancli-daemon
#   systemctl --user stop  leancli-daemon
#   journalctl --user -u leancli-daemon -f
