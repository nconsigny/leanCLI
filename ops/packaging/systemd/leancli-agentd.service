[Unit]
# leancli-agentd — user-mode systemd unit for the persistent Lean-native
# LLM agent daemon (Phase 1a). Stays up for the user's session and
# serves session-scoped chat turns over
# $XDG_RUNTIME_DIR/leancli/agent.sock, backed by an SQLite session
# store at $XDG_DATA_HOME/leancli/sessions.db.
#
# Trust contract carry-forward from Phase 0:
#   * No signing path; the agent proposes, the wallet daemon signs.
#   * Tool dispatch is allowlist-gated in Lean (Agent.Tools.dispatch).
#   * HTTP egress is loopback-only at the C layer (c/lean_http).
#
# leancli-agentd does NOT depend on systemd activation. The companion
# LlmAgent.Bridge auto-detects the socket; absent the daemon, the
# wallet daemon's chat.draft path falls back to the Phase 0 one-shot
# leancli-agent binary. So this unit is optional convenience: it lets
# the agent keep session history across calls instead of starting
# from scratch every time.
#
# Unlike leancli-daemon, this unit DOES carry an [Install] section
# because persistent sessions only make sense if the daemon is up
# whenever the user is logged in.
Description=Kohaku Agent Daemon (persistent LLM sessions)
After=leancli-daemon.service
# Soft dependency: agentd is useful without the wallet daemon (it can
# still create / search sessions), so use Wants= rather than Requires=
# to keep the agent reachable for read-only ops even if the wallet
# daemon is intentionally stopped.
Wants=leancli-daemon.service

[Service]
Type=simple
# Match the leancli-daemon unit's pattern: leanclispawn installs the
# binary under %h/.leancli/bin/. PKGBUILD users who install to
# /usr/bin/ can override via `systemctl --user edit leancli-agentd`.
ExecStart=%h/.leancli/bin/leancli-agentd

# Picks up LEANCLI_AGENT_LLM_URL, LEANCLI_AGENT_MODEL, etc. The leading
# `-` makes the unit tolerant of a missing file.
EnvironmentFile=-%h/.config/leancli/agent.env

Restart=on-failure
RestartSec=2

StandardOutput=journal
StandardError=journal

# Hardening — broader than leancli-daemon's because the agent does NOT
# need to touch the user's wallet state. It only writes
# %h/.local/share/leancli and reads %t/leancli.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
LockPersonality=yes
# Allow writes to the XDG state dir + the UDS runtime dir only.
ReadWritePaths=%h/.local/share/leancli %t/leancli
# UDS + loopback HTTP only — no raw sockets, no IPC besides Unix.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

KillMode=control-group
TimeoutStopSec=10

[Install]
WantedBy=default.target
