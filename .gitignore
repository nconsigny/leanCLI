# Colibri stateless light client runtime cache (written to cwd by C4Client
# WASM when the daemon spawns the sidecar without an explicit storage dir).
states_*
sync_*
code_*

# Local Claude Code agent state (memory, transcripts, agent definitions).
.claude/

# Sphincs sidecar build artifacts (binaries built by sidecars/sphincs/Makefile,
# copied into .lake/build/bin/ by the lake hook). Source stays tracked.
/sidecars/sphincs/bin/
/sidecars/sphincs/vendor-c9/target/

# Local scratch planning docs.
/simplification.md

# Runtime diagnostic dumps (daemon.log / agentd.log captured for debugging).
/_diag/

# Sphincs C13 (Rust) + Vulkan slhvk build artifacts — source stays tracked.
/sidecars/sphincs/vendor-c13/target/
/sidecars/sphincs/vendor-slhvk-sha2-128-24/lib/
/sidecars/sphincs/vendor-slhvk-sha2-128-24/src/*.o
/sidecars/sphincs/vendor-slhvk-sha2-128-24/src/shaders/*.spv
/sidecars/sphincs/vendor-slhvk-sha2-128-24/src/shaders/*.h
/sidecars/sphincs/vendor-slhvk-sha2-128-24/slhdsa-sha2-128-24-gpu
/sidecars/sphincs/vendor-slhvk-sha2-128-24/*.test

# Nix build outputs
/result
/result-*
