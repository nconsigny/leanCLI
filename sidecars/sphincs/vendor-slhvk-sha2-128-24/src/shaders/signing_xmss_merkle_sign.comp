#version 430
#extension GL_GOOGLE_include_directive : enable
#include "signing_common.comp"

// XMSS merkle build — BOTTOM PHASE (levels 1..PARALLEL_TOP).
//
// 128-24 fork: this shader is split from upstream slhvk's single-shader merkle
// build into two compute dispatches so that a Vulkan pipeline barrier (queue-
// level sync) — much stronger than the intra-shader barrier() — separates the
// bottom-tree (parallel) work from the top-tree (single-thread, shared-memory)
// work. The split eliminates the NVIDIA-driver-specific cross-thread SSBO
// race we observed at h'=22 in the upper auth-path entries.
//
// Levels 1..PARALLEL_TOP run here in parallel using SSBO (xmss_node_states).
// Auth-path entries 0..PARALLEL_TOP are written in this dispatch.
// Levels PARALLEL_TOP+1..XMSS_HEIGHT and auth-path entries PARALLEL_TOP+1..XMSS_HEIGHT-1
// are handled by signing_xmss_merkle_sign_top.comp in the second dispatch.

#define PARALLEL_TOP 16

layout(binding = 2) coherent buffer xmssnodes {
  uint xmss_node_states[HYPERTREE_LAYERS][XMSS_LEAVES][HASH_WORDS];
};

layout(binding = 3) buffer htsig {
  XmssSignature hypertree_signature[HYPERTREE_LAYERS];
};

layout(binding = 4) buffer rootmsg {
  uint xmss_root_messages[HYPERTREE_LAYERS][WOTS_CHAIN_COUNT];
};

void xmss_node_merge(
  uint64 tree_address,
  uint layer_address,
  uint lnode_pos,
  uint rnode_pos,
  uint node_height,
  uint node_index
) {
  uint schedule[64];
  define_schedule_2hash(
    layer_address,
    ADRS_TYPE_TREE,
    0, /* keypair_address */
    node_height,
    node_index,
    tree_address,
    xmss_node_states[layer_address][lnode_pos],
    xmss_node_states[layer_address][rnode_pos],
    schedule
  );
  uint s[8] = {
    sha256_state[0], sha256_state[1], sha256_state[2], sha256_state[3],
    sha256_state[4], sha256_state[5], sha256_state[6], sha256_state[7]
  };
  sha256_rounds_all(s, schedule);
  for (uint i = 0; i < HASH_WORDS; i++) {
    xmss_node_states[layer_address][lnode_pos][i] = s[i];
  }
}

void main() {
  uint local_id = gl_LocalInvocationID.x;
  uint layer_address = gl_WorkGroupID.x;
  uint64 tree_address_shifted = shifted_tree_address(tree_address, XMSS_HEIGHT, layer_address);

  uint our_layer_signing_keypair_address = layer_address == 0
    ? signing_keypair_address
    : (shifted_tree_address(tree_address, XMSS_HEIGHT, layer_address - 1).lo & (XMSS_LEAVES - 1));

  // Height-0 auth-path entry: sibling leaf at position kp^1.
  if (local_id == 0) {
    uint first_hash_offset = our_layer_signing_keypair_address ^ 1;
    for (uint i = 0; i < HASH_WORDS; i++) {
      hypertree_signature[layer_address].xmss_merkle_path[0][i] = flip_endianness(xmss_node_states[layer_address][first_hash_offset][i]);
    }
  }

  // Parallel build for levels 1..(PARALLEL_TOP-1).
  for (uint node_height = 1; node_height < PARALLEL_TOP; node_height++) {
    const uint next_level_nodes_len = 1 << (XMSS_HEIGHT - node_height);
    uint prev_layer_node_offset = (1 << (node_height - 1));

    for (uint node_index = local_id; node_index < next_level_nodes_len; node_index += gl_WorkGroupSize.x) {
      uint lchild_offset = (node_index * 2) * prev_layer_node_offset;
      uint rchild_offset = (node_index * 2 + 1) * prev_layer_node_offset;
      xmss_node_merge(tree_address_shifted, layer_address, lchild_offset, rchild_offset, node_height, node_index);
      if (node_index == ((our_layer_signing_keypair_address >> node_height) ^ 1)) {
        for (uint i = 0; i < HASH_WORDS; i++) {
          hypertree_signature[layer_address].xmss_merkle_path[node_height][i] = flip_endianness(xmss_node_states[layer_address][lchild_offset][i]);
        }
      }
    }
    memoryBarrier();
    barrier();
  }

  // 128-24 fork: serialize the FINAL parallel level (PARALLEL_TOP = 16) on
  // thread 0. With workgroup_size=64 and 64 level-16 merges, thread 0 does all
  // 64 sequentially. This eliminates the cross-thread sync at the last
  // parallel level — empirically the LAST level's last node (node 63) was
  // race-y on NVIDIA at h'=22; serializing here forces intra-thread reads
  // which are deterministic. The 64 SHA-256 compressions are cheap (microseconds).
  if (local_id == 0) {
    uint node_height = PARALLEL_TOP;
    const uint next_level_nodes_len = 1u << (XMSS_HEIGHT - node_height);
    uint prev_layer_node_offset = 1u << (node_height - 1);
    for (uint node_index = 0; node_index < next_level_nodes_len; node_index++) {
      uint lchild_offset = (node_index * 2) * prev_layer_node_offset;
      uint rchild_offset = (node_index * 2 + 1) * prev_layer_node_offset;
      xmss_node_merge(tree_address_shifted, layer_address, lchild_offset, rchild_offset, node_height, node_index);
      if (node_index == ((our_layer_signing_keypair_address >> node_height) ^ 1)) {
        for (uint i = 0; i < HASH_WORDS; i++) {
          hypertree_signature[layer_address].xmss_merkle_path[node_height][i] = flip_endianness(xmss_node_states[layer_address][lchild_offset][i]);
        }
      }
    }
  }
  memoryBarrier();
  barrier();
}
