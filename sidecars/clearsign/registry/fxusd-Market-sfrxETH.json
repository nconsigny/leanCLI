{
  "$schema": "../../specs/erc7730-v2.schema.json",
  "context": {
    "contract": {
      "deployments": [
        {
          "chainId": 1,
          "address": "0x714B853b3bA73E439c652CfE79660F329E6ebB42"
        }
      ]
    }
  },
  "metadata": {
    "owner": "f(x) Protocol \u2014 sfrxETH market",
    "info": {
      "url": "https://docs.aladdin.club/fx-protocol/"
    },
    "constants": {
      "baseToken": "0xac3e018457b222d93114458476f3e3416abbe38f",
      "fToken": "0x085780639CC2cACd35E474e71f4d000e2405d8f6",
      "xToken": "0x2bb0C32101456F5960d4e994Bac183Fe0dc6C82c",
      "baseTicker": "sfrxETH",
      "fTicker": "fxUSD",
      "xTicker": "xfrxETH"
    }
  },
  "display": {
    "formats": {
      "mintFToken(uint256 baseIn,address recipient,uint256 minFTokenMinted)": {
        "intent": "Mint fxUSD with sfrxETH",
        "fields": [
          {
            "label": "Collateral in",
            "format": "tokenAmount",
            "params": {
              "token": "$.metadata.constants.baseToken"
            },
            "path": "#.baseIn",
            "visible": "always"
          },
          {
            "label": "fxUSD recipient",
            "format": "addressName",
            "params": {
              "types": [
                "eoa",
                "wallet"
              ]
            },
            "path": "#.recipient",
            "visible": "always"
          },
          {
            "label": "Min fxUSD out",
            "format": "tokenAmount",
            "params": {
              "token": "$.metadata.constants.fToken"
            },
            "path": "#.minFTokenMinted",
            "visible": "always"
          }
        ]
      },
      "mintXToken(uint256 baseIn,address recipient,uint256 minXTokenMinted)": {
        "intent": "Mint xfrxETH (leveraged ETH) with sfrxETH",
        "fields": [
          {
            "label": "Collateral in",
            "format": "tokenAmount",
            "params": {
              "token": "$.metadata.constants.baseToken"
            },
            "path": "#.baseIn",
            "visible": "always"
          },
          {
            "label": "xfrxETH recipient",
            "format": "addressName",
            "params": {
              "types": [
                "eoa",
                "wallet"
              ]
            },
            "path": "#.recipient",
            "visible": "always"
          },
          {
            "label": "Min xfrxETH out",
            "format": "tokenAmount",
            "params": {
              "token": "$.metadata.constants.xToken"
            },
            "path": "#.minXTokenMinted",
            "visible": "always"
          }
        ]
      },
      "redeemFToken(uint256 fTokenIn,address recipient,uint256 minBaseOut)": {
        "intent": "Redeem fxUSD for sfrxETH",
        "fields": [
          {
            "label": "fxUSD in",
            "format": "tokenAmount",
            "params": {
              "token": "$.metadata.constants.fToken"
            },
            "path": "#.fTokenIn",
            "visible": "always"
          },
          {
            "label": "Collateral recipient",
            "format": "addressName",
            "params": {
              "types": [
                "eoa",
                "wallet"
              ]
            },
            "path": "#.recipient",
            "visible": "always"
          },
          {
            "label": "Min sfrxETH out",
            "format": "tokenAmount",
            "params": {
              "token": "$.metadata.constants.baseToken"
            },
            "path": "#.minBaseOut",
            "visible": "always"
          }
        ]
      },
      "redeemXToken(uint256 xTokenIn,address recipient,uint256 minBaseOut)": {
        "intent": "Redeem xfrxETH for sfrxETH",
        "fields": [
          {
            "label": "xfrxETH in",
            "format": "tokenAmount",
            "params": {
              "token": "$.metadata.constants.xToken"
            },
            "path": "#.xTokenIn",
            "visible": "always"
          },
          {
            "label": "Collateral recipient",
            "format": "addressName",
            "params": {
              "types": [
                "eoa",
                "wallet"
              ]
            },
            "path": "#.recipient",
            "visible": "always"
          },
          {
            "label": "Min sfrxETH out",
            "format": "tokenAmount",
            "params": {
              "token": "$.metadata.constants.baseToken"
            },
            "path": "#.minBaseOut",
            "visible": "always"
          }
        ]
      }
    }
  }
}
