{
  "name": "leancli-bridge",
  "version": "0.0.1",
  "private": true,
  "description": "Untrusted Node sidecar exposing @kohaku-eth/{plugins,railgun,privacy-pools} to the leanCLI daemon over JSON-RPC. Inputs and outputs are re-validated in Lean.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "bridge.mjs",
  "bin": {
    "leancli-bridge": "bridge.mjs"
  },
  "dependencies": {
    "@kohaku-eth/plugins": "0.0.1-alpha.11",
    "@kohaku-eth/railgun": "0.0.1-alpha.28",
    "@kohaku-eth/privacy-pools": "0.0.2-alpha.14",
    "@kohaku-eth/tornado-cash": "0.0.2-alpha.18",
    "ethers": "6.16.0"
  },
  "overrides": {
    "tar": "7.5.21",
    "ws": "8.21.1"
  },
  "scripts": {
    "start": "node bridge.mjs",
    "test": "node --no-warnings --experimental-loader ./loader.mjs --test tornado.test.mjs plugin-api.test.mjs max-amount.test.mjs"
  }
}
