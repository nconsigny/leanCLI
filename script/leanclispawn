#!/usr/bin/env bash
# leanclispawn — installer/updater for the leancli CLI, modeled on `foundryup`.
#
# Bootstrap (foundryup-style, no clone needed):
#   curl -fsSL https://raw.githubusercontent.com/nconsigny/leanCLI/master/script/leanclispawn | bash
#       → clones the repo to $LEANCLI_HOME/checkouts/leanCLI, builds, and
#         self-installs into $LEANCLI_HOME/bin (default: ~/.leancli/bin).
#
# First run from an existing clone:
#   ./script/leanclispawn
#       → uses the current checkout instead of cloning; everything else
#         is the same.
#
# After that, `leanclispawn` (from anywhere) re-runs against the recorded
# checkout. The checkout location is persisted in ~/.leancli/checkout.
#
# Uninstall:
#   leanclispawn --uninstall
set -euo pipefail

# Resolve LEANCLI_HOME (default ~/.leancli, like foundryup uses ~/.foundry).
LEANCLI_HOME="${LEANCLI_HOME:-$HOME/.leancli}"
LEANCLI_BIN="$LEANCLI_HOME/bin"
CHECKOUT_FILE="$LEANCLI_HOME/checkout"

# Bootstrap defaults: where to clone the repo if no checkout is found.
LEANCLI_REPO_URL="${LEANCLI_REPO_URL:-https://github.com/nconsigny/leanCLI.git}"
LEANCLI_REPO_DIR="${LEANCLI_REPO_DIR:-$LEANCLI_HOME/checkouts/leanCLI}"

# Resolve the script's source location. realpath isn't always present, so
# fall back to a portable readlink loop. This lets `~/.leancli/bin/leanclispawn`
# (a symlink) trace back to the script in the actual checkout.
resolve_self() {
  local src="$1"
  while [[ -L "$src" ]]; do
    local dir target
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    target="$(readlink "$src")"
    if [[ "$target" = /* ]]; then
      src="$target"
    else
      src="$dir/$target"
    fi
  done
  cd -P "$(dirname "$src")" && pwd -P
}

# BASH_SOURCE[0] is unbound when bash reads from stdin (`bash -s` /
# `curl ... | bash`), and `set -u` blows up on the array access. Default
# to empty: a missing source path means "no on-disk script" — the
# detect_checkout fast path is skipped and we fall through to the
# recorded checkout / bootstrap clone.
_self_src="${BASH_SOURCE[0]:-}"
if [[ -n "$_self_src" ]]; then
  SELF_DIR="$(resolve_self "$_self_src")"
else
  SELF_DIR=""
fi
unset _self_src

# Locate the checkout: prefer the script's own repo (works when running
# `./script/leanclispawn`), otherwise consult $LEANCLI_HOME/checkout (works when
# running `leanclispawn` from the user-bin symlink after first install).
detect_checkout() {
  if [[ -n "$SELF_DIR" && -f "$SELF_DIR/../lakefile.lean" ]]; then
    (cd "$SELF_DIR/.." && pwd -P)
    return 0
  fi
  if [[ -f "$CHECKOUT_FILE" ]]; then
    local dir
    dir="$(cat "$CHECKOUT_FILE")"
    if [[ -f "$dir/lakefile.lean" ]]; then
      printf '%s\n' "$dir"
      return 0
    fi
  fi
  return 1
}

# Foundryup-style bootstrap: when no checkout is found (typical for
# `curl ... | bash`), clone the repo into $LEANCLI_REPO_DIR and use that.
# If the target already has a lakefile, refresh it to origin's default
# branch so a second `curl | bash` actually picks up new commits. The
# bootstrap dir is treated as a managed install location, not a dev tree
# — users who develop in their own clone go through the detect_checkout
# fast path instead and never reach here.
bootstrap_clone() {
  if ! command -v git >/dev/null 2>&1; then
    echo "leanclispawn: bootstrap needs git on PATH (set LEANCLI_REPO_DIR to an existing clone to skip)" >&2
    return 1
  fi
  if [[ -f "$LEANCLI_REPO_DIR/lakefile.lean" ]]; then
    if [[ -d "$LEANCLI_REPO_DIR/.git" ]]; then
      echo "==> bootstrap: refreshing $LEANCLI_REPO_DIR from origin" >&2
      local default_branch
      default_branch="$(git -C "$LEANCLI_REPO_DIR" symbolic-ref --short HEAD 2>/dev/null || echo master)"
      if git -C "$LEANCLI_REPO_DIR" fetch --depth=1 origin "$default_branch" >&2 \
         && git -C "$LEANCLI_REPO_DIR" reset --hard FETCH_HEAD >&2; then
        :
      else
        echo "leanclispawn: refresh failed, continuing with current checkout" >&2
      fi
    fi
    printf '%s\n' "$LEANCLI_REPO_DIR"
    return 0
  fi
  echo "==> bootstrap: cloning $LEANCLI_REPO_URL into $LEANCLI_REPO_DIR" >&2
  mkdir -p "$(dirname "$LEANCLI_REPO_DIR")"
  if ! git clone --depth=1 "$LEANCLI_REPO_URL" "$LEANCLI_REPO_DIR" >&2; then
    echo "leanclispawn: clone failed" >&2
    return 1
  fi
  printf '%s\n' "$LEANCLI_REPO_DIR"
}

usage() {
  cat <<'EOF'
Usage: leanclispawn [options]

Installs or updates the `leancli` CLI from a local clone of leanCLI.

Options:
  --pull              `git pull` the checkout before building.
  --no-build          Skip `lake build`. Use when binaries are already current.
  --no-tui            Skip the Ink TUI bundle build. `leancli tui` will not work.
  --rebuild-tui       Force rebuilding the TUI bundle even if dist/ is present.
  --no-bridges        Skip `npm install` for the bridge/ sidecars. Colibri,
                      clearsign, privacy and LLM features will be degraded.
  --rebuild-bridges   Force reinstalling sidecar deps even when node_modules
                      already exists.
  --no-helpers        Skip building the HACL + secp256k1 native helpers. Wallet
                      crypto (PBKDF2, secp256k1 signing, BIP-32 derivation,
                      keystore wrapping) will be non-functional until they are
                      built. Useful only on systems where helpers are
                      pre-installed in /usr/bin (Arch/Nix packaging).
  --rebuild-helpers   Force rebuilding native helpers even when present in
                      .lake/build/bin/. Pair with --pull when the HACL or
                      secp256k1 pinned revision has moved.
  --restart           After install, restart leancli-daemon and leancli-agentd
                      via `systemctl --user restart`. Only restarts units
                      that were already active — never starts a stopped
                      daemon. `leancli update` passes this implicitly.
  --full              Shortcut for --pull --rebuild-tui --rebuild-bridges
                      --rebuild-helpers --restart. The "do-everything"
                      update for when you want a clean rebuild of all
                      pieces in one command (slower; rebuilds HACL +
                      secp256k1 from source which takes minutes).
  --no-modify-path    Do not append the leancli bin dir to your shell rc.
  --no-completion     Skip installing shell-completion files. By default,
                      completion is installed for bash, zsh, AND fish so
                      switching shells later doesn't require re-running.
  --no-init           Skip the interactive first-run wizard (RPC URL +
                      wallet master passphrase). Implied when stdin/stdout
                      is not a TTY (covers `curl ... | bash` and CI).
  --force             Overwrite existing leancli / leancli-daemon symlinks
                      that point somewhere else. Default refuses.
  --uninstall         Remove ~/.leancli/bin/{leancli,kohaku,leancli-daemon,leancli-agent,leancli-agentd,leanclispawn}
                      and the XDG skills symlink under
                      $XDG_DATA_HOME/leancli/skills (only when those
                      symlinks point at the recorded checkout; pair with
                      --force to override). Leaves shell-rc edits in
                      place — they're harmless once the directory is
                      gone, and removing them automatically would risk
                      eating other edits.
  -h, --help          Show this help.

Environment:
  LEANCLI_HOME         Install root (default: $HOME/.leancli). Binaries land
                      under $LEANCLI_HOME/bin.
EOF
}

PULL=0
BUILD_LEAN=1
BUILD_TUI=auto        # auto | always | never
BUILD_BRIDGES=auto    # auto | always | never
BUILD_HELPERS=auto    # auto | always | never — HACL + secp256k1 native helpers
RESTART_DAEMONS=0     # restart leancli-daemon + leancli-agentd at end (only if active)
MODIFY_PATH=1
INSTALL_COMPLETION=1
RUN_INIT_WIZARD=1
FORCE=0
MODE=install      # install | uninstall

while [[ $# -gt 0 ]]; do
  case "$1" in
    --pull) PULL=1; shift;;
    --no-build) BUILD_LEAN=0; shift;;
    --no-tui) BUILD_TUI=never; shift;;
    --rebuild-tui) BUILD_TUI=always; shift;;
    --no-bridges) BUILD_BRIDGES=never; shift;;
    --rebuild-bridges) BUILD_BRIDGES=always; shift;;
    --no-helpers) BUILD_HELPERS=never; shift;;
    --rebuild-helpers) BUILD_HELPERS=always; shift;;
    --restart) RESTART_DAEMONS=1; shift;;
    --full)
      PULL=1
      BUILD_TUI=always
      BUILD_BRIDGES=always
      BUILD_HELPERS=always
      RESTART_DAEMONS=1
      shift;;
    --no-modify-path) MODIFY_PATH=0; shift;;
    --no-completion) INSTALL_COMPLETION=0; shift;;
    --no-init) RUN_INIT_WIZARD=0; shift;;
    --force) FORCE=1; shift;;
    --uninstall) MODE=uninstall; shift;;
    -h|--help) usage; exit 0;;
    *) echo "leanclispawn: unknown option: $1" >&2; usage >&2; exit 2;;
  esac
done

require() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "leanclispawn: required tool not found on PATH: $1" >&2
    exit 1
  fi
}

# ---- systemd user-unit + autospawn-marker paths -----------------------------
#
# Honor XDG_CONFIG_HOME for both the systemd user-unit dir and the leancli
# config dir. Both fall back to $HOME/.config per the XDG spec. Keep this
# group in one place so install and uninstall use the exact same paths.
SYSTEMD_USER_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
SYSTEMD_UNIT_NAME="leancli-daemon.service"
SYSTEMD_UNIT_PATH="$SYSTEMD_USER_DIR/$SYSTEMD_UNIT_NAME"
# Phase 1a sibling: the persistent agent daemon. Installed alongside
# the wallet daemon so chat sessions have memory + history across
# turns without the user having to opt in. The unit's [Install] hook
# enables it at default.target when the user runs
# `systemctl --user enable --now leancli-agentd`.
SYSTEMD_AGENTD_UNIT_NAME="leancli-agentd.service"
SYSTEMD_AGENTD_UNIT_PATH="$SYSTEMD_USER_DIR/$SYSTEMD_AGENTD_UNIT_NAME"
LEANCLI_CFG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/leancli"
LEANCLI_ENV_FILE="$LEANCLI_CFG_DIR/daemon.env"
LEANCLI_SYSTEMD_MARKER="$LEANCLI_CFG_DIR/managed-by-systemd"

# XDG data dir hosting the agent's session DB, MEMORY.md, and (Phase 1b)
# the skills tree symlink. Mirrors `AgentDaemonMain.resolveSkillsDir`'s
# preference order so the symlink lands on rung 2 of that resolution.
LEANCLI_DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/leancli"
LEANCLI_SKILLS_LINK="$LEANCLI_DATA_DIR/skills"

# One-shot cleanup of stragglers. Today's diagnosis was 5 stale leancli-daemon
# PIDs and 8 orphan bridge.mjs sidecars all bound to the same UDS path —
# the result of autospawn racing without single-instance protection. Killing
# them here gives the systemd unit (or a future autospawn) a clean slate.
# Only run if there's actually something to kill — a clean machine should
# print nothing.
kill_stale_leancli_processes() {
  local found_daemon=0 found_bridge=0
  if pgrep -x leancli-daemon >/dev/null 2>&1; then found_daemon=1; fi
  if pgrep -f 'bridge/colibri/bridge\.mjs' >/dev/null 2>&1; then found_bridge=1; fi
  if pgrep -f 'bridge/helios/bridge\.mjs' >/dev/null 2>&1; then found_bridge=1; fi
  if [[ $found_daemon -eq 0 && $found_bridge -eq 0 ]]; then
    return 0
  fi
  echo "==> cleaning stale leancli-daemon / bridge.mjs processes"
  # If the systemd unit is the manager and the daemon is part of its
  # cgroup, ask systemd to stop it cleanly first (KillMode=control-group
  # will sweep up the colibri sidecar via the cgroup). Best-effort —
  # falls through to pkill below if systemctl is missing or the unit is
  # inactive.
  if command -v systemctl >/dev/null 2>&1 \
     && systemctl --user is-active --quiet leancli-daemon 2>/dev/null; then
    systemctl --user stop leancli-daemon 2>/dev/null || true
  fi
  # SIGTERM the daemon FIRST so it gets a chance to clean up its colibri
  # sidecars itself (KillMode-equivalent for the manual case). Then mop
  # up any bridges that survived (e.g. orphaned by a previous crash, or
  # an autospawned daemon that's outside any cgroup we can reach).
  pkill -x leancli-daemon 2>/dev/null || true
  pkill -f 'bridge/colibri/bridge\.mjs' 2>/dev/null || true
  pkill -f 'bridge/helios/bridge\.mjs' 2>/dev/null || true
  # Brief grace period for the processes to exit cleanly.
  local i
  for i in 1 2 3 4 5; do
    if ! pgrep -x leancli-daemon >/dev/null 2>&1 \
       && ! pgrep -f 'bridge/colibri/bridge\.mjs' >/dev/null 2>&1 \
       && ! pgrep -f 'bridge/helios/bridge\.mjs' >/dev/null 2>&1; then
      break
    fi
    sleep 0.2
  done
  # Anything still alive after 1s gets the hammer.
  if pgrep -x leancli-daemon >/dev/null 2>&1; then
    echo "    SIGKILL surviving leancli-daemon PIDs: $(pgrep -x leancli-daemon | tr '\n' ' ')"
    pkill -9 -x leancli-daemon 2>/dev/null || true
  fi
  if pgrep -f 'bridge/colibri/bridge\.mjs' >/dev/null 2>&1; then
    echo "    SIGKILL surviving colibri bridge.mjs PIDs: $(pgrep -f 'bridge/colibri/bridge\.mjs' | tr '\n' ' ')"
    pkill -9 -f 'bridge/colibri/bridge\.mjs' 2>/dev/null || true
  fi
  if pgrep -f 'bridge/helios/bridge\.mjs' >/dev/null 2>&1; then
    echo "    SIGKILL surviving helios bridge.mjs PIDs: $(pgrep -f 'bridge/helios/bridge\.mjs' | tr '\n' ' ')"
    pkill -9 -f 'bridge/helios/bridge\.mjs' 2>/dev/null || true
  fi
}

# ---- uninstall path ---------------------------------------------------------

if [[ "$MODE" == "uninstall" ]]; then
  if [[ ! -d "$LEANCLI_BIN" ]]; then
    echo "leanclispawn: nothing to remove ($LEANCLI_BIN does not exist)"
    exit 0
  fi

  expected_checkout=""
  if [[ -f "$CHECKOUT_FILE" ]]; then
    expected_checkout="$(cat "$CHECKOUT_FILE")"
  fi

  remove_link() {
    local name="$1"
    local target_basename="$2"
    local linkpath="$LEANCLI_BIN/$name"
    if [[ ! -e "$linkpath" && ! -L "$linkpath" ]]; then
      return 0
    fi
    if [[ -L "$linkpath" ]]; then
      local current
      current="$(readlink "$linkpath")"
      if [[ -n "$expected_checkout" \
            && "$current" == "$expected_checkout/.lake/build/bin/$target_basename" ]]; then
        rm -f "$linkpath"
        echo "removed $linkpath"
      elif [[ $FORCE -eq 1 ]]; then
        rm -f "$linkpath"
        echo "removed $linkpath (--force, was -> $current)"
      else
        echo "leanclispawn: $linkpath -> $current does not point at the recorded checkout, leaving it alone (use --force to remove)" >&2
      fi
    elif [[ $FORCE -eq 1 ]]; then
      rm -f "$linkpath"
      echo "removed $linkpath (--force, was a regular file)"
    else
      echo "leanclispawn: $linkpath is not a symlink, leaving it alone (use --force to remove)" >&2
    fi
  }

  remove_link "leancli" "leancli"
  remove_link "kohaku" "leancli"
  remove_link "leancli-daemon" "leancli-daemon"
  # Agent binaries (Phase 0 + Phase 1a). Same checkout-rooted symlink
  # model; remove_link no-ops if the symlink is missing or points
  # outside the recorded checkout.
  remove_link "leancli-agent" "leancli_agent"
  remove_link "leancli-agentd" "leancli_agentd"

  # Phase 1b skills registry symlink: lives outside $LEANCLI_BIN (under
  # the XDG data dir) so it doesn't fit `remove_link`'s shape. Same
  # safety: only remove when it points at the recorded checkout's
  # `skills/` tree (so users who hand-rolled their own skills dir keep
  # it), or when --force is passed.
  if [[ -L "$LEANCLI_SKILLS_LINK" ]]; then
    skills_current="$(readlink "$LEANCLI_SKILLS_LINK")"
    if [[ -n "$expected_checkout" \
          && "$skills_current" == "$expected_checkout/skills" ]]; then
      rm -f "$LEANCLI_SKILLS_LINK"
      echo "removed $LEANCLI_SKILLS_LINK"
    elif [[ $FORCE -eq 1 ]]; then
      rm -f "$LEANCLI_SKILLS_LINK"
      echo "removed $LEANCLI_SKILLS_LINK (--force, was -> $skills_current)"
    else
      echo "leanclispawn: $LEANCLI_SKILLS_LINK -> $skills_current does not point at the recorded checkout, leaving it alone (use --force to remove)" >&2
    fi
    unset skills_current
  elif [[ -e "$LEANCLI_SKILLS_LINK" && $FORCE -eq 1 ]]; then
    rm -rf "$LEANCLI_SKILLS_LINK"
    echo "removed $LEANCLI_SKILLS_LINK (--force, was a regular directory)"
  fi
  # Best-effort: drop the now-empty XDG data dir, but leave it if it
  # still holds the SQLite session DB or any other agentd state.
  rmdir "$LEANCLI_DATA_DIR" 2>/dev/null || true
  # SPHINCS- shim symlinks (installed by `install_sphincs_shims`). Same
  # "checkout-rooted symlink" model as leancli/leancli-daemon, so the
  # check-and-remove pattern is the same — `remove_link` no-ops when the
  # symlink doesn't exist or points outside our managed checkout, so
  # users who hand-symlinked a sphincs-* binary to their own build won't
  # have it clobbered.
  remove_link "sphincs-slhdsa-128-24" "sphincs-slhdsa-128-24"
  remove_link "sphincs-slhdsa-128-24-vk" "sphincs-slhdsa-128-24-vk"
  remove_link "sphincs-c13" "sphincs-c13"
  # Legacy variants (pre-C13 / pre-rename installs): clean up stale symlinks.
  remove_link "sphincs-jardin-keccak-128-24" "sphincs-jardin-keccak-128-24"
  remove_link "sphincs-c9" "sphincs-c9"

  # leanclispawn itself was copied (not symlinked) so we can always remove it.
  if [[ -e "$LEANCLI_BIN/leanclispawn" ]]; then
    rm -f "$LEANCLI_BIN/leanclispawn"
    echo "removed $LEANCLI_BIN/leanclispawn"
  fi

  # Sidecar wrapper shims (installed by `install_bridge_wrappers`). These
  # are regular files (not symlinks) and only exist when their target
  # bridge.mjs lived under the recorded checkout at install time, so a
  # blanket rm -f is safe — no chance of nuking a user-managed wrapper
  # that happens to share the name.
  for bridge_exe in leancli-bridge leancli-clearsign-bridge \
                    leancli-colibri-bridge leancli-helios-bridge \
                    leancli-safenode-bridge \
                    leancli-llm-bridge leancli-llm-legacy; do
    if [[ -e "$LEANCLI_BIN/$bridge_exe" ]]; then
      rm -f "$LEANCLI_BIN/$bridge_exe"
      echo "removed $LEANCLI_BIN/$bridge_exe"
    fi
  done

  # Stop and remove the systemd user unit (and its autospawn marker). We
  # only ever `start`ed it manually — there's no `disable` step to mirror
  # because the unit ships without an [Install] section. Reload after
  # removal so `systemctl --user list-unit-files` reflects reality.
  if command -v systemctl >/dev/null 2>&1; then
    systemctl --user stop leancli-daemon 2>/dev/null || true
    systemctl --user disable --now leancli-agentd 2>/dev/null || true
  fi
  if [[ -f "$SYSTEMD_AGENTD_UNIT_PATH" ]]; then
    rm -f "$SYSTEMD_AGENTD_UNIT_PATH"
    echo "removed $SYSTEMD_AGENTD_UNIT_PATH"
  fi
  if [[ -f "$SYSTEMD_UNIT_PATH" ]]; then
    rm -f "$SYSTEMD_UNIT_PATH"
    echo "removed $SYSTEMD_UNIT_PATH"
    if command -v systemctl >/dev/null 2>&1; then
      systemctl --user daemon-reload 2>/dev/null || true
    fi
  fi
  if [[ -e "$LEANCLI_SYSTEMD_MARKER" ]]; then
    rm -f "$LEANCLI_SYSTEMD_MARKER"
    echo "removed $LEANCLI_SYSTEMD_MARKER"
  fi
  # Also clean up any stale leancli-daemon / bridge.mjs left running.
  kill_stale_leancli_processes

  # Drop the checkout marker but leave LEANCLI_HOME alone in case the user
  # has other state under it.
  rm -f "$CHECKOUT_FILE"
  rmdir "$LEANCLI_BIN" 2>/dev/null || true
  rmdir "$LEANCLI_HOME" 2>/dev/null || true

  echo
  echo "Uninstalled. Shell-rc PATH entries (if any) were left in place;"
  echo "remove them by hand if you don't intend to reinstall."
  exit 0
fi

# ---- install / update path --------------------------------------------------

CHECKOUT="$(detect_checkout || true)"
if [[ -z "${CHECKOUT:-}" ]]; then
  CHECKOUT="$(bootstrap_clone || true)"
fi
if [[ -z "${CHECKOUT:-}" ]]; then
  cat >&2 <<EOF
leanclispawn: could not find or clone a leanCLI checkout.

Tried:
  1. The script's own repo (running from inside a clone)
  2. $CHECKOUT_FILE
  3. Cloning $LEANCLI_REPO_URL into $LEANCLI_REPO_DIR

To fix, either:
  - git clone $LEANCLI_REPO_URL && cd leanCLI && ./script/leanclispawn
  - Or set LEANCLI_REPO_DIR to point at an existing clone.
EOF
  exit 1
fi

LEAN_BIN="$CHECKOUT/.lake/build/bin/leancli"
LEAN_DAEMON="$CHECKOUT/.lake/build/bin/leancli-daemon"
# Lean-native LLM agent (Phase 0). Installed as `leancli-agent`
# (dash form) because that's what LlmAgent.Bridge resolves on PATH.
# Lake target is `leancli_agent` (underscore) so the artefact lives
# at .lake/build/bin/leancli_agent.
LEAN_AGENT="$CHECKOUT/.lake/build/bin/leancli_agent"
# Phase 1a persistent agent daemon. Installed as `leancli-agentd`
# (dash form) to match the systemd unit name; the Lake target is
# `leancli_agentd` so the artefact lives at .lake/build/bin/leancli_agentd.
LEAN_AGENTD="$CHECKOUT/.lake/build/bin/leancli_agentd"
TUI_BUNDLE="$CHECKOUT/tui/dist/index.mjs"

# Kill any stale daemon/bridge processes before we touch anything else.
# Doing this *before* the build means the build can't accidentally race
# a running daemon that has the old binary mmap'd from a previous
# `leanclispawn --pull` (.lake/build/bin/leancli-daemon is overwritten
# in place). Doing it before the systemd install means we hand a clean
# process table over to the unit if the user starts it next.
kill_stale_leancli_processes

if [[ $PULL -eq 1 ]]; then
  require git
  echo "==> git pull ($CHECKOUT)"
  (cd "$CHECKOUT" && git pull --ff-only)
fi

if [[ $BUILD_LEAN -eq 1 ]]; then
  require lake
  echo "==> lake build"
  (cd "$CHECKOUT" && lake build)
  if [[ ! -x "$LEAN_BIN" || ! -x "$LEAN_DAEMON" ]]; then
    echo "leanclispawn: build succeeded but $LEAN_BIN / $LEAN_DAEMON are missing or not executable" >&2
    exit 1
  fi
fi

# SPHINCS- shim binaries (C + Rust). They live in `sidecars/sphincs/` and
# are NOT produced by `lake build` — the shim Makefile is shelled out by
# the `sphincs-shims` lake-script target. We invoke it here whenever the
# user asked for a Lean build, and best-effort skip when missing tools
# (gcc / cargo) so an install on a host that doesn't compile the shims
# still finishes — the daemon's `sphincs.*` RPCs just fail closed at use
# time with a clear "shim binary not found" message.
# Built by the Makefile's default `all` target (see sidecars/sphincs/Makefile:
# `all: slhdsa c13`). These are presence-checked and required-wired below.
SPHINCS_SHIMS=(sphincs-slhdsa-128-24 sphincs-c13)
# Opt-in Vulkan GPU signer for SLH-DSA-SHA2-128-24 (`make slhvk`; needs a
# Vulkan SDK + device). NOT part of `make all`, so it is wired only when the
# user has built it and is silent when absent — no spurious warning on hosts
# without a GPU. Matches Bridge.lean's `.slhDsaSha2_128_24 .vulkan` backend.
SPHINCS_SHIMS_OPTIONAL=(sphincs-slhdsa-128-24-vk)
build_sphincs_shims() {
  if [[ $BUILD_LEAN -ne 1 ]]; then
    return 0
  fi
  if [[ ! -d "$CHECKOUT/sidecars/sphincs" ]]; then
    return 0
  fi
  local all_present=1
  for shim in "${SPHINCS_SHIMS[@]}"; do
    if [[ ! -x "$CHECKOUT/.lake/build/bin/$shim" ]]; then
      all_present=0
      break
    fi
  done
  if [[ $all_present -eq 1 ]]; then
    echo "==> sphincs shims: present, skipping (use --rebuild-helpers to force)"
    return 0
  fi
  echo "==> sphincs shims: lake script run sphincs-shims"
  if ! (cd "$CHECKOUT" && lake script run sphincs-shims) >&2; then
    echo "leanclispawn: sphincs-shims build failed; sphincs.* RPCs will fail closed" >&2
  fi
}
build_sphincs_shims

build_tui() {
  if [[ "$BUILD_TUI" == "never" ]]; then
    echo "==> tui: skipped (--no-tui)"
    return 0
  fi
  # In "auto" mode, skip only if the bundle exists AND is newer than every
  # source file. The previous "present means skip" rule meant `leanclispawn
  # --pull` would happily pull new TUI source but ship the stale bundle to
  # users — exactly the failure mode we hit when shipping the KoiFrame
  # fix. find -newer prints any source that's newer than the bundle; an
  # empty result means we're up to date.
  if [[ "$BUILD_TUI" == "auto" && -f "$TUI_BUNDLE" ]]; then
    local newer
    newer="$(find "$CHECKOUT/tui/src" "$CHECKOUT/tui/package.json" \
                  "$CHECKOUT/tui/esbuild.config.mjs" \
                  -newer "$TUI_BUNDLE" -print -quit 2>/dev/null || true)"
    if [[ -z "$newer" ]]; then
      echo "==> tui: dist/index.mjs up to date, skipping (use --rebuild-tui to force)"
      return 0
    fi
    echo "==> tui: source newer than bundle ($newer), rebuilding"
  fi
  if [[ ! -d "$CHECKOUT/tui" ]]; then
    echo "leanclispawn: tui/ directory not found in $CHECKOUT, skipping TUI build" >&2
    return 0
  fi
  require node
  require npm
  echo "==> tui: npm install"
  (cd "$CHECKOUT/tui" && npm install --no-audit --no-fund)
  echo "==> tui: npm run build"
  (cd "$CHECKOUT/tui" && npm run build)
  if [[ ! -f "$TUI_BUNDLE" ]]; then
    echo "leanclispawn: tui build did not produce $TUI_BUNDLE" >&2
    exit 1
  fi
}

build_tui

# Native crypto helpers (HACL Packages + libsecp256k1). The daemon shells
# out to these for PBKDF2 (master KEK derivation, BIP-39 seed), HMAC-SHA-256/512
# (BIP-32 derivation), keccak/sha256, ChaCha20-Poly1305 (keystore wrapping),
# RIPEMD160 (BIP-32 fingerprint), and secp256k1 sign/pubkey/recover/verify.
# A fresh `lake build` does NOT produce them — they have their own bootstrap
# scripts that clone hacl-packages and bitcoin-core/secp256k1 then build
# small C helpers. Without these, `wallet master init` (and every signing
# op) fails with "could not execute external process 'leancli-hacl-*'".
build_native_helpers() {
  if [[ "$BUILD_HELPERS" == "never" ]]; then
    echo "==> native helpers: skipped (--no-helpers)"
    return 0
  fi
  # Canary files. We check ONE from each of the two setup scripts so a
  # partial install (e.g. interrupted secp256k1 stage) gets rebuilt.
  local hacl_canary="$CHECKOUT/.lake/build/bin/leancli-hacl-pbkdf2"
  local secp_canary="$CHECKOUT/.lake/build/bin/leancli-secp256k1-sign"
  if [[ "$BUILD_HELPERS" == "auto" ]]; then
    if [[ -x "$hacl_canary" && -x "$secp_canary" ]]; then
      echo "==> native helpers: present, skipping (use --rebuild-helpers to force)"
      return 0
    fi
    echo "==> native helpers: building (missing or incomplete)"
  fi
  local helper_missing=()
  for tool in git cmake ninja cc cargo; do
    if ! command -v "$tool" >/dev/null 2>&1; then
      helper_missing+=("$tool")
    fi
  done
  if [[ ${#helper_missing[@]} -ne 0 ]]; then
    echo "==> native helpers: SKIPPED — missing build tools (${helper_missing[*]})"
    echo "    Wallet crypto will fail at runtime until these are installed and"
    echo "    \`leanclispawn --rebuild-helpers\` is re-run."
    if command -v apt-get >/dev/null 2>&1; then
      echo "    Ubuntu: sudo apt install git cmake ninja-build gcc"
    elif command -v pacman >/dev/null 2>&1; then
      echo "    Arch:   sudo pacman -S git cmake ninja gcc"
    elif command -v dnf >/dev/null 2>&1; then
      echo "    Fedora: sudo dnf install git cmake ninja-build gcc"
    fi
    if [[ ! " ${helper_missing[*]} " == *" cargo "* ]]; then
      : # cargo already present
    else
      echo "    cargo:  https://rustup.rs/  (curl --proto =https --tlsv1.2 -sSf https://sh.rustup.rs | sh)"
    fi
    return 0
  fi
  echo "==> native helpers: script/setup_hacl.sh (HACL Packages — keccak, sha256, hmac, pbkdf2, drbg, chacha20poly1305 + RustCrypto ripemd160)"
  if ! (cd "$CHECKOUT" && bash script/setup_hacl.sh); then
    echo "leanclispawn: setup_hacl.sh failed — wallet crypto will not work until re-run" >&2
    return 1
  fi
  echo "==> native helpers: script/setup_secp256k1.sh (libsecp256k1 — sign, pubkey, recover, verify)"
  if ! (cd "$CHECKOUT" && bash script/setup_secp256k1.sh); then
    echo "leanclispawn: setup_secp256k1.sh failed — EOA signing will not work until re-run" >&2
    return 1
  fi
}

build_native_helpers

# Sidecar JSON-RPC bridges (privacy/Railgun, clearsign, colibri light client,
# LLM agent). Each is a stdio Node process spawned by the daemon; deps must
# be installed for `leancli daemon` to use them. Missing deps degrade
# gracefully — e.g. the daemon falls back to the configured RPC instead of
# Colibri's stateless verification — but the warnings are noisy.
build_bridges() {
  if [[ "$BUILD_BRIDGES" == "never" ]]; then
    echo "==> bridges: skipped (--no-bridges)"
    return 0
  fi
  if [[ ! -d "$CHECKOUT/bridge" ]]; then
    return 0
  fi
  require node
  require npm
  local any=0
  # Top-level bridge/ (privacy) plus each bridge/<name>/ subpackage.
  for pkg_json in "$CHECKOUT/bridge/package.json" "$CHECKOUT/bridge"/*/package.json; do
    [[ -f "$pkg_json" ]] || continue
    local dir
    dir="$(dirname "$pkg_json")"
    local rel="${dir#$CHECKOUT/}"
    if [[ "$BUILD_BRIDGES" == "auto" && -d "$dir/node_modules" ]]; then
      echo "==> $rel: node_modules present, skipping (use --rebuild-bridges to force)"
      continue
    fi
    echo "==> $rel: npm install"
    (cd "$dir" && npm install --no-audit --no-fund)
    any=1
  done
  if [[ $any -eq 0 && "$BUILD_BRIDGES" == "auto" ]]; then
    echo "==> bridges: all up to date"
  fi
}

build_bridges

mkdir -p "$LEANCLI_BIN"

# Persist the checkout location so future bare `leanclispawn` invocations
# (running from $LEANCLI_BIN/leanclispawn) know where to rebuild.
printf '%s\n' "$CHECKOUT" > "$CHECKOUT_FILE"

link_one() {
  local target="$1"
  local linkname="$2"
  local linkpath="$LEANCLI_BIN/$linkname"

  if [[ -L "$linkpath" ]]; then
    local current
    current="$(readlink "$linkpath")"
    if [[ "$current" == "$target" ]]; then
      echo "==> $linkpath -> $target (already linked)"
      return 0
    fi
    if [[ $FORCE -ne 1 ]]; then
      echo "leanclispawn: $linkpath already points to $current" >&2
      echo "  use --force to overwrite, or remove it manually." >&2
      exit 1
    fi
    rm -f "$linkpath"
  elif [[ -e "$linkpath" ]]; then
    if [[ $FORCE -ne 1 ]]; then
      echo "leanclispawn: $linkpath exists and is not a symlink" >&2
      echo "  use --force to overwrite, or remove it manually." >&2
      exit 1
    fi
    rm -f "$linkpath"
  fi

  ln -s "$target" "$linkpath"
  echo "==> $linkpath -> $target"
}

# Symlink the checkout's `skills/` tree into the XDG data dir so the
# agent daemon's `resolveSkillsDir` finds it on rung 2 of its preference
# order (`$XDG_DATA_HOME/leancli/skills`). Without this, the agent
# daemon falls through to `<cwd>/skills`; under systemd the working
# directory is the user's home, so `cwd/skills` resolves to a path
# that doesn't exist and `protocol_lookup` returns an empty registry.
#
# Mirrors `link_one`'s safety: idempotent on a correct symlink, --force
# required to overwrite either a wrong symlink or a regular dir/file.
# The target is a directory, not an executable, so we don't gate on
# `-x`; we just require the source path to exist.
install_skills_link() {
  local target="$1"
  if [[ ! -d "$target" ]]; then
    echo "leanclispawn: $target not found — skipping skills symlink" >&2
    return 0
  fi
  mkdir -p "$LEANCLI_DATA_DIR"
  if [[ -L "$LEANCLI_SKILLS_LINK" ]]; then
    local current
    current="$(readlink "$LEANCLI_SKILLS_LINK")"
    if [[ "$current" == "$target" ]]; then
      echo "==> $LEANCLI_SKILLS_LINK -> $target (already linked)"
      return 0
    fi
    if [[ $FORCE -ne 1 ]]; then
      echo "leanclispawn: $LEANCLI_SKILLS_LINK already points to $current" >&2
      echo "  use --force to overwrite, or remove it manually." >&2
      exit 1
    fi
    rm -f "$LEANCLI_SKILLS_LINK"
  elif [[ -e "$LEANCLI_SKILLS_LINK" ]]; then
    if [[ $FORCE -ne 1 ]]; then
      echo "leanclispawn: $LEANCLI_SKILLS_LINK exists and is not a symlink" >&2
      echo "  use --force to overwrite, or remove it manually." >&2
      exit 1
    fi
    rm -rf "$LEANCLI_SKILLS_LINK"
  fi
  ln -s "$target" "$LEANCLI_SKILLS_LINK"
  echo "==> $LEANCLI_SKILLS_LINK -> $target"
}

link_one "$LEAN_BIN" "leancli"
# Short alias users type interactively. Points at the same leancli binary;
# the CLI reads argv[0] and renders help/usage as `kohaku` when invoked so.
link_one "$LEAN_BIN" "kohaku"
link_one "$LEAN_DAEMON" "leancli-daemon"
# Agent binaries are best-effort: an older checkout that predates Phase 0
# won't have built them. Skip-with-warning rather than fail the install.
if [[ -x "$LEAN_AGENT" ]]; then
  link_one "$LEAN_AGENT" "leancli-agent"
else
  echo "leanclispawn: $LEAN_AGENT not built — skipping leancli-agent symlink" >&2
fi
if [[ -x "$LEAN_AGENTD" ]]; then
  link_one "$LEAN_AGENTD" "leancli-agentd"
else
  echo "leanclispawn: $LEAN_AGENTD not built — skipping leancli-agentd symlink" >&2
fi
# Phase 1b skills registry: point the agent daemon at the checkout's
# `skills/` tree. Best-effort like the agent binaries — if the directory
# is missing (very old checkout), we warn and skip rather than fail.
install_skills_link "$CHECKOUT/skills"

# Add-or-replace a key=value line in $LEANCLI_ENV_FILE. Same dance the
# sphincs loop uses below; factored out so the agent and any future
# env-key install path share one implementation.
leancli_env_set() {
  local var="$1"
  local val="$2"
  mkdir -p "$LEANCLI_CFG_DIR"
  if [[ ! -e "$LEANCLI_ENV_FILE" ]]; then
    {
      printf '%s\n' "# leancli-daemon environment file."
      printf '%s\n' "# Read by the systemd user unit (leancli-daemon.service) and by"
      printf '%s\n' "# shell-launched daemons that source it. This file is auxiliary;"
      printf '%s\n' "# per-chain RPC config lives in daemon.json next to it."
    } > "$LEANCLI_ENV_FILE"
    chmod 0600 "$LEANCLI_ENV_FILE" 2>/dev/null || true
  fi
  if grep -qE "^${var}=" "$LEANCLI_ENV_FILE" 2>/dev/null; then
    local current
    current="$(grep -E "^${var}=" "$LEANCLI_ENV_FILE" | head -n1 | cut -d= -f2-)"
    if [[ "$current" != "$val" ]]; then
      local tmp
      tmp="$(mktemp "$LEANCLI_ENV_FILE.XXXXXX")"
      awk -v var="$var" -v val="$val" '
        $0 ~ "^"var"=" { print var"="val; seen=1; next }
        { print }
        END { if (!seen) print var"="val }
      ' "$LEANCLI_ENV_FILE" > "$tmp"
      chmod 0600 "$tmp" 2>/dev/null || true
      mv "$tmp" "$LEANCLI_ENV_FILE"
      echo "==> $LEANCLI_ENV_FILE: updated $var (was $current)"
    fi
  else
    printf '%s=%s\n' "$var" "$val" >> "$LEANCLI_ENV_FILE"
    echo "==> $LEANCLI_ENV_FILE: added $var"
  fi
}

# LEANCLI_LLM_BRIDGE — pin the leancli-agent path in daemon.env so
# the wallet daemon resolves it regardless of PATH. Systemd-managed
# daemons typically run with a minimal PATH that excludes ~/.leancli/bin,
# so even after the symlink lands the daemon can fail to spawn the
# bridge with exit code 127. Same reasoning as the sphincs env vars
# below.
if [[ -x "$LEAN_AGENT" ]]; then
  leancli_env_set "LEANCLI_LLM_BRIDGE" "$LEANCLI_BIN/leancli-agent"
fi

# Helios light-client defaults. The sidecar itself is auto-installed by
# `build_bridges` (any bridge/<name>/ with a package.json is npm-installed
# in place), and the wrapper-shim resolver picks up `bridge/helios/`. The
# remaining piece is opt-in at the daemon-boot level — the daemon checks
# `LEANCLI_HELIOS=1` before auto-spawning the persistent helios client, and
# `LEANCLI_READ_BACKEND=helios` to default `tx.simulate` to the helios
# backend. We bake both in so a fresh install gets sync-committee-verified
# simulation by default; users can flip them off via daemon.env edits or
# `daemon.readBackend.set { backend: rpc }` at runtime.
if [[ -f "$CHECKOUT/bridge/helios/package.json" ]]; then
  leancli_env_set "LEANCLI_HELIOS"        "1"
  leancli_env_set "LEANCLI_READ_BACKEND"  "helios"
fi

# SPHINCS- shim symlinks + daemon.env entries. The daemon's
# `Sphincs/Bridge.lean::resolveExecutable` checks `LEANCLI_SPHINCS_<PARAMSET>`
# env first, then walks up from cwd looking for `sidecars/sphincs/bin/<basename>`,
# then falls through to PATH. The PATH branch is unreliable for systemd-
# managed daemons (the unit's `PATH` typically doesn't include `~/.leancli/bin`),
# so we ALSO record each shim's absolute path in `daemon.env` — that's what
# the bundled bridge wrappers do. Symlinks are kept for shell-launched
# daemons and for users who put `~/.leancli/bin` on their own PATH.
# Missing-binary case is non-fatal: we skip the env var + symlink for that
# variant; the daemon fails closed at the per-RPC use site with a clear
# "shim binary not found" message.
sphincs_env_var_for() {
  case "$1" in
    sphincs-slhdsa-128-24)        echo "LEANCLI_SPHINCS_SLHDSA";;
    sphincs-slhdsa-128-24-vk)     echo "LEANCLI_SPHINCS_SLHDSA_VK";;
    sphincs-c13)                  echo "LEANCLI_SPHINCS_C13";;
  esac
}
for shim in "${SPHINCS_SHIMS[@]}" "${SPHINCS_SHIMS_OPTIONAL[@]}"; do
  shim_path="$CHECKOUT/.lake/build/bin/$shim"
  if [[ ! -x "$shim_path" ]]; then
    # Opt-in (Vulkan) shims are silent when absent; required shims warn.
    case " ${SPHINCS_SHIMS_OPTIONAL[*]} " in
      *" $shim "*) : ;;
      *) echo "leanclispawn: sphincs shim $shim missing at $shim_path — sphincs.* RPCs will fail closed" >&2 ;;
    esac
    continue
  fi
  link_one "$shim_path" "$shim"
  envvar="$(sphincs_env_var_for "$shim")"
  if [[ -z "$envvar" ]]; then continue; fi
  # daemon.env may not exist yet — install_bridge_wrappers below pre-creates
  # it, but we run BEFORE that section so handle creation here too. Same
  # mode-0600 + add/replace dance install_bridge_wrappers uses.
  mkdir -p "$LEANCLI_CFG_DIR"
  if [[ ! -e "$LEANCLI_ENV_FILE" ]]; then
    {
      printf '%s\n' "# leancli-daemon environment file."
      printf '%s\n' "# Read by the systemd user unit (leancli-daemon.service) and by"
      printf '%s\n' "# shell-launched daemons that source it. This file is auxiliary;"
      printf '%s\n' "# per-chain RPC config lives in daemon.json next to it."
    } > "$LEANCLI_ENV_FILE"
    chmod 0600 "$LEANCLI_ENV_FILE" 2>/dev/null || true
  fi
  if grep -qE "^${envvar}=" "$LEANCLI_ENV_FILE" 2>/dev/null; then
    current="$(grep -E "^${envvar}=" "$LEANCLI_ENV_FILE" | head -n1 | cut -d= -f2-)"
    if [[ "$current" != "$shim_path" ]]; then
      tmp="$(mktemp "$LEANCLI_ENV_FILE.XXXXXX")"
      awk -v var="$envvar" -v val="$shim_path" '
        $0 ~ "^"var"=" { print var"="val; seen=1; next }
        { print }
        END { if (!seen) print var"="val }
      ' "$LEANCLI_ENV_FILE" > "$tmp"
      chmod 0600 "$tmp" 2>/dev/null || true
      mv "$tmp" "$LEANCLI_ENV_FILE"
      echo "==> $LEANCLI_ENV_FILE: updated $envvar (was $current)"
    fi
  else
    printf '%s=%s\n' "$envvar" "$shim_path" >> "$LEANCLI_ENV_FILE"
    echo "==> $LEANCLI_ENV_FILE: added $envvar"
  fi
done

# ---- sidecar wrapper shims --------------------------------------------------
#
# The daemon spawns four Node sidecars (privacy/shielded, clearsign
# descriptor decoder, colibri light-client, llm agent). Each resolver in
# LeanCli/.../Bridge.lean checks an env var first, then a cwd-relative
# in-checkout path, then falls back to a PATH-resolved name like
# `leancli-clearsign-bridge`. Without these wrappers the PATH fallback
# always fails (we never installed any sidecar binaries), and the
# cwd-relative path only hits when the user happens to `cd` into the
# checkout — so under systemd or any "ran from elsewhere" shell, four out
# of four sidecars crash silently and the daemon serves degraded results
# (TUI shows "no descriptor matched · raw calldata only", chat falls
# through to error, etc.).
#
# Fix: install one exec-wrapper per sidecar at $LEANCLI_BIN/leancli-*-bridge
# that hard-codes node + the absolute path to the checkout's bridge.mjs.
# The same path is also written into $LEANCLI_ENV_FILE as
# LEANCLI_*_BRIDGE so the systemd unit (which doesn't see $LEANCLI_BIN
# on PATH) resolves the same exe via env var.
install_bridge_wrappers() {
  if [[ "$BUILD_BRIDGES" == "never" ]]; then
    echo "==> bridge wrappers: skipped (--no-bridges)"
    return 0
  fi
  if [[ ! -d "$CHECKOUT/bridge" ]]; then
    return 0
  fi
  require node
  local node_path
  node_path="$(command -v node)"

  # exe : relative-path-from-CHECKOUT : env-var-name
  local rows=(
    "leancli-bridge:bridge/bridge.mjs:LEANCLI_BRIDGE"
    "leancli-clearsign-bridge:bridge/clearsign/bridge.mjs:LEANCLI_CLEARSIGN_BRIDGE"
    "leancli-colibri-bridge:bridge/colibri/bridge.mjs:LEANCLI_COLIBRI_BRIDGE"
    "leancli-helios-bridge:bridge/helios/bridge.mjs:LEANCLI_HELIOS_BRIDGE"
    # TDX-attested ORAM proxy (SafeNode/Bridge.lean). The wrapper only execs
    # node + bridge.mjs; the upstream TDX_QUOTE_VERIFIER_BIN it needs at
    # runtime is a separate, user-supplied dependency.
    "leancli-safenode-bridge:bridge/safenode/bridge.mjs:LEANCLI_SAFENODE_BRIDGE"
    "leancli-llm-legacy:bridge/llm-legacy/bridge.mjs:LEANCLI_LLM_BRIDGE_LEGACY_PATH"
  )

  # daemon.env may not exist yet — the wizard creates it only after the
  # user supplies an RPC URL. Pre-create it (mode 0600) so we can write
  # bridge env vars regardless of wizard ordering. The wizard's
  # `ensure_daemon_env` appends LEANCLI_RPC_URL idempotently later.
  mkdir -p "$LEANCLI_CFG_DIR"
  if [[ ! -e "$LEANCLI_ENV_FILE" ]]; then
    {
      printf '%s\n' "# leancli-daemon environment file."
      printf '%s\n' "# Read by the systemd user unit (leancli-daemon.service) and by"
      printf '%s\n' "# shell-launched daemons that source it. This file is auxiliary;"
      printf '%s\n' "# per-chain RPC config lives in daemon.json next to it."
    } > "$LEANCLI_ENV_FILE"
    chmod 0600 "$LEANCLI_ENV_FILE" 2>/dev/null || true
  fi

  local installed=0
  for row in "${rows[@]}"; do
    local exe rel envvar target shim
    IFS=: read -r exe rel envvar <<< "$row"
    target="$CHECKOUT/$rel"
    shim="$LEANCLI_BIN/$exe"
    if [[ ! -f "$target" ]]; then
      echo "leanclispawn: bridge wrapper $exe — target $target missing, skipping" >&2
      continue
    fi
    # Hard-code both the node path and the bridge.mjs path so the wrapper
    # works under any PATH (systemd default PATH doesn't include
    # ~/.leancli/bin or even ~/.nvm/.../bin). Re-running leanclispawn after
    # moving the checkout regenerates the wrapper.
    cat > "$shim" <<EOF
#!/usr/bin/env bash
# Auto-generated by leanclispawn — wrapper for the $exe sidecar.
# Re-run \`leanclispawn\` to refresh this file after moving the checkout.
exec "$node_path" "$target" "\$@"
EOF
    chmod 0755 "$shim"
    echo "==> $shim (-> $node_path $target)"

    # Mirror into daemon.env. Idempotent: skip if already present, replace
    # if the line exists but points elsewhere (e.g. checkout moved).
    if grep -qE "^${envvar}=" "$LEANCLI_ENV_FILE" 2>/dev/null; then
      # Replace existing line in place. sed -i is portable enough for
      # the systems we target; the awk fallback handles BSD sed.
      local current
      current="$(grep -E "^${envvar}=" "$LEANCLI_ENV_FILE" | head -n1 | cut -d= -f2-)"
      if [[ "$current" != "$target" ]]; then
        # Rewrite the file rather than `sed -i` to avoid GNU/BSD divergence.
        local tmp
        tmp="$(mktemp "$LEANCLI_ENV_FILE.XXXXXX")"
        awk -v var="$envvar" -v val="$target" '
          $0 ~ "^"var"=" { print var"="val; seen=1; next }
          { print }
          END { if (!seen) print var"="val }
        ' "$LEANCLI_ENV_FILE" > "$tmp"
        chmod 0600 "$tmp" 2>/dev/null || true
        mv "$tmp" "$LEANCLI_ENV_FILE"
        echo "==> $LEANCLI_ENV_FILE: updated $envvar (was $current)"
      fi
    else
      printf '%s=%s\n' "$envvar" "$target" >> "$LEANCLI_ENV_FILE"
      echo "==> $LEANCLI_ENV_FILE: added $envvar"
    fi
    installed=$((installed + 1))
  done
  if [[ $installed -eq 0 ]]; then
    echo "==> bridge wrappers: none installed (no bridge.mjs targets found in $CHECKOUT/bridge/)"
  fi
}

install_bridge_wrappers

# ---- bundled bridge data files ---------------------------------------------
#
# The privacy sidecars read pre-synced state files from disk on cold
# start to skip the multi-minute initial chain walk:
#
#   bridge/ppv1-sepolia-state.json     — Privacy Pools v1, Sepolia
#   bridge/ppv1-mainnet-state.json     — Privacy Pools v1, mainnet
#   bridge/railgun-sepolia-snapshot.json — Railgun (alpha-21), Sepolia
#   bridge/railgun-mainnet-snapshot.json — Railgun (alpha-21), mainnet
#
# These files live in the checkout next to bridge.mjs and are picked
# up by the bridge via `__dirname`. The wrapper shims installed above
# already point at the checkout, so no copy step is needed — we just
# report presence so the user can spot drift and regenerate.
report_bridge_data_assets() {
  local missing=0
  local data_pair
  for data_pair in \
      "Privacy Pools (Sepolia):ppv1-sepolia-state.json" \
      "Privacy Pools (mainnet):ppv1-mainnet-state.json" \
      "Railgun (Sepolia):railgun-sepolia-snapshot.json" \
      "Railgun (mainnet):railgun-mainnet-snapshot.json"; do
    local label="${data_pair%%:*}"
    local fname="${data_pair##*:}"
    local path="$CHECKOUT/bridge/$fname"
    if [[ -f "$path" ]]; then
      local bytes
      bytes=$(stat -c%s "$path" 2>/dev/null || echo "?")
      echo "==> bridge data: $label  $path ($bytes bytes)"
    else
      missing=$((missing + 1))
    fi
  done
  if [[ $missing -gt 0 ]]; then
    echo "==> bridge data: $missing snapshot(s) missing — cold-sync will be slow on first call."
    echo "    Regenerate Railgun Sepolia (~minutes, needs SEPOLIA_RPC_URL):"
    echo "      lake build leancli-railgun-snapshot"
    echo "      lake env .lake/build/bin/leancli-railgun-snapshot"
  fi
}
report_bridge_data_assets

# ---- sidecar sandbox probe --------------------------------------------------
#
# `LeanCli.Util.Sandbox.wrap` wraps every sidecar `IO.Process.spawn`
# with `unshare --user --map-current-user --pid --fork ...` so a
# prompt-injected sidecar can't see the daemon's pid or reach localhost.
# That syscall sequence requires `unshare` to be allowed to write
# `/proc/self/uid_map`. Two common host policies block this:
#
#   - Ubuntu 23.10+ AppArmor: `kernel.apparmor_restrict_unprivileged_userns=1`
#     refuses unprivileged user-namespace creation for binaries outside
#     the distribution's allowlist. `unshare(1)` is not on that list, so
#     every sidecar spawn fails with "unshare: write failed
#     /proc/self/uid_map: Operation not permitted".
#   - Distros with `kernel.unprivileged_userns_clone=0` (some hardened
#     configs and older Debians).
#
# The Lean side's `auto` mode only degrades when `unshare(1)` is absent
# from PATH; it doesn't detect the runtime EPERM case. Until that
# detection is moved into Lean, probe here at install time and force
# `LEANCLI_SANDBOX=off` in daemon.env when the probe fails — without
# it, every sidecar (clearsign, privacy, llm) silently crashes and the
# daemon reports `{ok:false, crash:...}` to the TUI / CLI.
probe_userns_sandbox() {
  if ! command -v unshare >/dev/null 2>&1; then
    echo "==> sandbox probe: unshare(1) missing — Lean side will warn and skip wrapping"
    return 0
  fi
  if unshare --user --map-current-user -- true >/dev/null 2>&1; then
    echo "==> sandbox probe: OK (unprivileged user namespaces work)"
    # If a previous install forced sandbox off (host policy changed since),
    # drop the override now so the daemon goes back to the sandboxed default.
    if [[ -f "$LEANCLI_ENV_FILE" ]] \
       && grep -qE '^LEANCLI_SANDBOX=off' "$LEANCLI_ENV_FILE" 2>/dev/null; then
      local tmp
      tmp="$(mktemp "$LEANCLI_ENV_FILE.XXXXXX")"
      grep -vE '^LEANCLI_SANDBOX=' "$LEANCLI_ENV_FILE" > "$tmp" || true
      chmod 0600 "$tmp" 2>/dev/null || true
      mv "$tmp" "$LEANCLI_ENV_FILE"
      echo "==> $LEANCLI_ENV_FILE: removed LEANCLI_SANDBOX=off (host now allows userns)"
    fi
    return 0
  fi

  # Probe failed. Surface the exact reason so the user knows what to fix
  # if they want sandboxing back. AppArmor's restriction toggle is the
  # most common cause on Ubuntu 24+.
  local reason=""
  if [[ -r /proc/sys/kernel/apparmor_restrict_unprivileged_userns ]] \
     && [[ "$(cat /proc/sys/kernel/apparmor_restrict_unprivileged_userns)" == "1" ]]; then
    reason="AppArmor unprivileged-userns restriction (Ubuntu 23.10+ default)"
  elif [[ -r /proc/sys/kernel/unprivileged_userns_clone ]] \
       && [[ "$(cat /proc/sys/kernel/unprivileged_userns_clone)" == "0" ]]; then
    reason="kernel.unprivileged_userns_clone=0 (hardened/Debian default)"
  else
    reason="unknown (unshare exits non-zero — try 'unshare --user --map-current-user -- true' manually)"
  fi

  mkdir -p "$LEANCLI_CFG_DIR"
  touch "$LEANCLI_ENV_FILE"
  chmod 0600 "$LEANCLI_ENV_FILE" 2>/dev/null || true
  if grep -qE '^LEANCLI_SANDBOX=' "$LEANCLI_ENV_FILE" 2>/dev/null; then
    local tmp
    tmp="$(mktemp "$LEANCLI_ENV_FILE.XXXXXX")"
    awk '$0 ~ "^LEANCLI_SANDBOX=" { print "LEANCLI_SANDBOX=off"; seen=1; next } { print } END { if (!seen) print "LEANCLI_SANDBOX=off" }' \
      "$LEANCLI_ENV_FILE" > "$tmp"
    chmod 0600 "$tmp" 2>/dev/null || true
    mv "$tmp" "$LEANCLI_ENV_FILE"
  else
    printf 'LEANCLI_SANDBOX=off\n' >> "$LEANCLI_ENV_FILE"
  fi
  cat >&2 <<EOF
==> sandbox probe: FAILED — disabling sidecar sandbox
    Cause: $reason
    Effect: sidecars run in the daemon's namespace (no PID/UTS/IPC/net isolation).
            The cryptographic trust model is unchanged — the daemon still
            re-decodes every signed tx before broadcast — but a compromised
            sidecar has more reach at the OS level.

    To restore the sandbox (recommended on shared / multi-user hosts):
      Ubuntu 23.10+ (AppArmor):
        sudo sysctl -w kernel.apparmor_restrict_unprivileged_userns=0
        # to persist: echo 'kernel.apparmor_restrict_unprivileged_userns=0' \\
        #   | sudo tee /etc/sysctl.d/99-leancli-userns.conf
      Hardened kernel:
        sudo sysctl -w kernel.unprivileged_userns_clone=1
      Then: leanclispawn   # re-runs the probe and clears LEANCLI_SANDBOX=off
EOF
}

probe_userns_sandbox

# Self-install: copy the canonical script from $CHECKOUT/script/leanclispawn
# into $LEANCLI_BIN so the user can run `leanclispawn` from anywhere. We
# always source from the checkout (never $BASH_SOURCE) because the latter
# can be /dev/stdin under `curl ... | bash`, which has already been
# consumed by the time we get here. Copy rather than symlink so deleting
# or moving the checkout doesn't break the updater — the copy still finds
# the checkout via $CHECKOUT_FILE.
SCRIPT_SOURCE="$CHECKOUT/script/leanclispawn"
INSTALLED_SELF="$LEANCLI_BIN/leanclispawn"
if [[ ! -f "$SCRIPT_SOURCE" ]]; then
  echo "leanclispawn: $SCRIPT_SOURCE missing — cannot self-install. Is the checkout on a commit older than the script?" >&2
elif [[ "$SCRIPT_SOURCE" != "$INSTALLED_SELF" ]]; then
  install -m 0755 "$SCRIPT_SOURCE" "$INSTALLED_SELF"
  echo "==> $INSTALLED_SELF (self-installed from $SCRIPT_SOURCE)"
fi

# ---- systemd user unit install ---------------------------------------------
#
# Ship the repo's `packaging/systemd/leancli-daemon.service` into the user's
# systemd unit dir so they can manage the daemon with the standard
# `systemctl --user {start,stop,status}` verbs. The unit has no [Install]
# section on purpose — we never `enable` it and never call `loginctl
# enable-linger`. Manual lifecycle only.
#
# The presence of the unit alone isn't enough to disable autospawn — some
# users may install the unit but still want the CLI/TUI to launch the
# daemon on demand. The `managed-by-systemd` marker is the actual switch
# that turns autospawn off (checked by DaemonClient.lean and tui/daemon.ts).
install_unit_file() {
  local unit_name="$1"
  local dest_path="$2"
  local src="$CHECKOUT/packaging/systemd/$unit_name"
  if [[ ! -f "$src" ]]; then
    echo "leanclispawn: $src missing — skipping $unit_name install" >&2
    return 0
  fi
  mkdir -p "$SYSTEMD_USER_DIR"
  if ! install -m 0644 "$src" "$dest_path"; then
    echo "leanclispawn: failed to install $dest_path" >&2
    return 1
  fi
  echo "==> $dest_path (installed)"
}

install_systemd_unit() {
  install_unit_file "$SYSTEMD_UNIT_NAME" "$SYSTEMD_UNIT_PATH"
  # Phase 1a: persistent agent daemon. Skip the install if the agent
  # binary wasn't built (older checkouts predating Phase 0/1a) — the
  # unit's ExecStart would just fail. The wallet daemon keeps working
  # without the agent (chat falls back to one-shot leancli-agent).
  if [[ -x "$LEAN_AGENTD" ]]; then
    install_unit_file "$SYSTEMD_AGENTD_UNIT_NAME" "$SYSTEMD_AGENTD_UNIT_PATH"
  else
    echo "leanclispawn: $LEAN_AGENTD not built — skipping leancli-agentd.service" >&2
  fi
  if command -v systemctl >/dev/null 2>&1; then
    # `daemon-reload` is mandatory after copying a unit file — without it
    # `systemctl --user start leancli-daemon` would either fail to find the
    # unit or run an outdated cached copy. Failing the reload isn't fatal
    # for the install (the user can reload manually), so swallow errors.
    systemctl --user daemon-reload 2>/dev/null || \
      echo "leanclispawn: systemctl --user daemon-reload failed (continuing)" >&2
    # Enable + start leancli-agentd if the unit is now present. The
    # daemon unit is intentionally not enabled (manual lifecycle per
    # its own design), but the agent unit's only purpose is to keep
    # session memory across chats — enabling it by default is the
    # least-surprising behaviour for users who installed via
    # leanclispawn.
    if [[ -f "$SYSTEMD_AGENTD_UNIT_PATH" ]]; then
      systemctl --user enable --now leancli-agentd 2>/dev/null \
        && echo "==> systemctl --user enable --now leancli-agentd" \
        || echo "leanclispawn: failed to enable leancli-agentd (manual: 'systemctl --user enable --now leancli-agentd')" >&2
    fi
  else
    echo "leanclispawn: systemctl not on PATH — skipped daemon-reload" >&2
  fi
}

install_systemd_unit

# The autospawn marker (`$LEANCLI_SYSTEMD_MARKER`) is intentionally NOT
# created here. First-run onboarding (`launch_first_run_tui` /
# `prompt_master_init`) needs the daemon up to call `wallet.master.init`,
# and the marker would disable autospawn before the user has a chance to
# `systemctl --user start leancli-daemon`. Instead, we let autospawn handle
# the wizard, then flip the marker on at the very end of the script (see
# `finalize_systemd_handoff` below) and hand the user a clean
# "systemctl --user start" footer.

# ---- daemon.env mirror from onboarding -------------------------------------
#
# `daemon.json` is what the daemon actually reads for per-chain RPC; this
# file is auxiliary, picked up by the systemd unit's EnvironmentFile= line
# so unit-managed runs see the same LEANCLI_RPC_URL the user might have
# in their shell env. We only write it when we can supply a sensible
# value — never overwriting an existing customized file.
ensure_daemon_env() {
  local rpc_url="${LEANCLI_RPC_URL:-}"
  if [[ -z "$rpc_url" ]]; then
    # Nothing to mirror right now. The `prompt_rpc_setup` flow below will
    # call back into this function once a URL is collected from the user.
    return 0
  fi
  if [[ -s "$LEANCLI_ENV_FILE" ]]; then
    # Existing non-empty file — respect the user's customization. Only
    # add LEANCLI_RPC_URL if it's not already present. This makes the
    # function idempotent across re-runs.
    if grep -qE '^LEANCLI_RPC_URL=' "$LEANCLI_ENV_FILE" 2>/dev/null; then
      return 0
    fi
    {
      printf 'LEANCLI_RPC_URL=%s\n' "$rpc_url"
    } >> "$LEANCLI_ENV_FILE"
    chmod 0600 "$LEANCLI_ENV_FILE" 2>/dev/null || true
    echo "==> $LEANCLI_ENV_FILE: added LEANCLI_RPC_URL"
    return 0
  fi
  mkdir -p "$LEANCLI_CFG_DIR"
  local tmp
  tmp="$(mktemp "$LEANCLI_ENV_FILE.XXXXXX")"
  {
    printf '%s\n' "# leancli-daemon environment file."
    printf '%s\n' "# Read by the systemd user unit (leancli-daemon.service) and by"
    printf '%s\n' "# shell-launched daemons that source it. This file is auxiliary;"
    printf '%s\n' "# per-chain RPC config lives in daemon.json next to it."
    printf 'LEANCLI_RPC_URL=%s\n' "$rpc_url"
  } > "$tmp"
  chmod 0600 "$tmp" 2>/dev/null || true
  mv "$tmp" "$LEANCLI_ENV_FILE"
  echo "==> $LEANCLI_ENV_FILE (created)"
}

ensure_daemon_env

# ---- shell-rc PATH integration (foundryup-style) ----------------------------
#
# Append a single guarded block to one shell rc so future shells pick up
# $LEANCLI_BIN. We don't try to merge into existing PATH lines — just append
# a marker block we can recognize on re-runs.

PATH_LINE="export PATH=\"\$HOME/.leancli/bin:\$PATH\""
RC_MARKER="# >>> leanclispawn PATH >>>"
RC_END="# <<< leanclispawn PATH <<<"

pick_rc() {
  local shell_name
  shell_name="$(basename "${SHELL:-}")"
  case "$shell_name" in
    zsh) printf '%s\n' "$HOME/.zshrc";;
    bash)
      if [[ -f "$HOME/.bashrc" ]]; then printf '%s\n' "$HOME/.bashrc"
      else printf '%s\n' "$HOME/.profile"; fi
      ;;
    fish) printf '%s\n' "$HOME/.config/fish/config.fish";;
    *) printf '%s\n' "$HOME/.profile";;
  esac
}

modify_path() {
  local rc shell_name
  rc="$(pick_rc)"
  shell_name="$(basename "${SHELL:-}")"
  mkdir -p "$(dirname "$rc")"
  touch "$rc"
  if grep -q "$RC_MARKER" "$rc" 2>/dev/null; then
    echo "==> $rc: leanclispawn PATH block already present"
    return 0
  fi
  if [[ "$shell_name" == "fish" ]]; then
    {
      printf '\n%s\n' "$RC_MARKER"
      printf '%s\n' 'set -gx PATH $HOME/.leancli/bin $PATH'
      printf '%s\n' "$RC_END"
    } >> "$rc"
  else
    {
      printf '\n%s\n' "$RC_MARKER"
      printf '%s\n' "$PATH_LINE"
      printf '%s\n' "$RC_END"
    } >> "$rc"
  fi
  echo "==> $rc: appended leanclispawn PATH block"
}

if [[ $MODIFY_PATH -eq 1 ]]; then
  case ":${PATH:-}:" in
    *":$LEANCLI_BIN:"*) ;;            # already on PATH; no-op
    *) modify_path;;
  esac
fi

# ---- shell-completion install -----------------------------------------------
#
# Install completion for bash, zsh, AND fish unconditionally. The three
# target dirs are disjoint and each shell only reads its own, so writing
# all three is harmless even if the user only ever runs one shell — and
# it means switching shells later (or having multiple shells on the same
# box) just works without re-running. Re-runs are idempotent (files are
# overwritten).
#
# The one shell-specific side-effect is the zsh fpath/compinit block in
# ~/.zshrc; we only append it when zsh is actually installed, so we don't
# create a stray ~/.zshrc on a bash-only box.

emit_completion() {
  local shell_kind="$1" target_dir="$2" target_file="$3"
  mkdir -p "$target_dir"
  if ! "$LEAN_BIN" completion "$shell_kind" > "$target_file"; then
    echo "leanclispawn: failed to emit $shell_kind completion" >&2
    rm -f "$target_file"
    return 1
  fi
  echo "==> $shell_kind completion -> $target_file"
}

install_completion() {
  local rc=0

  local bash_dir="${XDG_DATA_HOME:-$HOME/.local/share}/bash-completion/completions"
  emit_completion bash "$bash_dir" "$bash_dir/leancli" || rc=1

  local zsh_dir="${XDG_DATA_HOME:-$HOME/.local/share}/zsh/site-functions"
  emit_completion zsh "$zsh_dir" "$zsh_dir/_leancli" || rc=1

  local fish_dir="${XDG_CONFIG_HOME:-$HOME/.config}/fish/completions"
  emit_completion fish "$fish_dir" "$fish_dir/leancli.fish" || rc=1

  # zsh needs $zsh_dir on $fpath and a compinit call to actually load the
  # completion. Only wire up ~/.zshrc when zsh is on PATH — on a bash-only
  # box, creating a ~/.zshrc the user never reads is just litter.
  if command -v zsh >/dev/null 2>&1; then
    local zshrc="$HOME/.zshrc"
    local marker="# >>> leanclispawn completion >>>"
    local end_marker="# <<< leanclispawn completion <<<"
    touch "$zshrc"
    if grep -q "$marker" "$zshrc" 2>/dev/null; then
      echo "==> $zshrc: leanclispawn completion block already present"
    else
      {
        printf '\n%s\n' "$marker"
        printf '%s\n' "fpath=(\"$zsh_dir\" \$fpath)"
        printf '%s\n' 'autoload -Uz compinit && compinit -i'
        printf '%s\n' "$end_marker"
      } >> "$zshrc"
      echo "==> $zshrc: appended completion fpath/compinit block"
    fi
  fi

  return $rc
}

if [[ $INSTALL_COMPLETION -eq 1 ]]; then
  install_completion || echo "leanclispawn: completion install failed (non-fatal, continuing)" >&2
fi

# ---- TPM2 readiness probe (informational) -----------------------------------
#
# `leancli wallet master init` / `bind-tpm` can optionally seal the wallet
# KEK under a TPM-bound PIN, giving BIP-39 EOA seeds hardware-tier
# protection (dictionary-attack lockout enforced by TPM firmware). This
# probe surfaces what's missing so the user knows exactly which package
# / group / BIOS toggle to fix — without it, `leancli wallet master
# status` just reports `tpmHardwareReady: false` and the user is on
# their own.
#
# All three checks are soft (warn-only) — a working passphrase-only
# install is still a fully functional leancli. We exit 0 either way.
echo
echo "==> TPM2 hardware probe (optional, enables \`wallet master bind-tpm\`):"

tpm_device_present=0
if [[ -e /dev/tpm0 || -e /dev/tpmrm0 ]]; then
  tpm_device_present=1
  echo "  ✓ kernel TPM device present"
else
  echo "  - no /dev/tpm* device — enable fTPM/PTT in BIOS to use TPM-bound unlock"
fi

tpm_tools_missing=()
for tool in tpm2_createprimary tpm2_create tpm2_load tpm2_unseal; do
  if ! command -v "$tool" >/dev/null 2>&1; then
    tpm_tools_missing+=("$tool")
  fi
done
if [[ ${#tpm_tools_missing[@]} -eq 0 ]]; then
  echo "  ✓ tpm2-tools installed"
else
  echo "  - tpm2-tools missing (${tpm_tools_missing[*]}); install with:"
  if command -v pacman >/dev/null 2>&1; then
    echo "      sudo pacman -S tpm2-tools tpm2-tss"
  elif command -v apt-get >/dev/null 2>&1; then
    echo "      sudo apt install tpm2-tools libtss2-tcti-device0"
  elif command -v dnf >/dev/null 2>&1; then
    echo "      sudo dnf install tpm2-tools tpm2-tss"
  else
    echo "      (consult your distro's package manager for the tpm2-tools package)"
  fi
fi

# Group check: the TPM device files are typically group `tss` mode 660,
# so an unprivileged user can't open them without group membership. We
# probe by checking both whether the user is in `tss` and whether they
# can actually read /dev/tpmrm0 — the latter accounts for distros that
# use a different group name. Surface the simpler "add to tss" hint
# when that's the most likely fix.
if [[ $tpm_device_present -eq 1 ]]; then
  if [[ -r /dev/tpmrm0 ]] || [[ -r /dev/tpm0 ]]; then
    echo "  ✓ user can access TPM device"
  else
    tss_group=""
    if getent group tss >/dev/null 2>&1; then
      tss_group="tss"
    fi
    if [[ -n "$tss_group" ]] && ! id -nG "$USER" 2>/dev/null | tr ' ' '\n' | grep -qx "$tss_group"; then
      echo "  - TPM device unreadable; add yourself to the '$tss_group' group:"
      echo "      sudo usermod -aG $tss_group \$USER"
      echo "      newgrp $tss_group       # picks up the group in this shell"
      echo "      leancli daemon stop && leancli daemon ping   # daemon respawns with new group"
    else
      echo "  - TPM device exists but is unreadable (check udev rules / device perms)"
    fi
  fi
fi
echo "  After fixing any of the above, verify with: leancli wallet master status"

# ---- First-run wizard: RPC URL + wallet master passphrase -------------------
#
# Two pieces a fresh install otherwise leaves the user to discover:
#   1. The daemon refuses to start without an RPC URL (see
#      LeanCli/Daemon/Config.lean). Without one, `wallet master init`
#      would fail when it tries to auto-spawn the daemon.
#   2. The wallet master KEK (one passphrase wraps every EOA seed + the PP
#      secret); without it every EOA needs its own per-slot passphrase.
#
# Preferred surface: `leancli tui`. Its BootGate walks the same dependency
# chain — RpcSetupGate (writes daemon.json directly from Node, no daemon
# needed), then MasterInitGate, then MasterUnlockGate — and is the same UI
# the user gets on every subsequent `leancli tui` launch, so first-run looks
# like normal-run. The shell `prompt_*` helpers below are kept as the
# `--no-tui` fallback for headless installs.
#
# Skip rules:
#   - --no-init flag,
#   - non-TTY stdin/stdout (covers `curl ... | bash` and CI),
#   - both checks already pass (RPC configured AND master.json present).

has_rpc_configured() {
  local v
  for v in LEANCLI_RPC_URL LEANCLI_RPC_URL_MAINNET LEANCLI_RPC_URL_SEPOLIA \
           MAINNET_RPC_URL SEPOLIA_RPC_URL; do
    if [[ -n "${!v:-}" ]]; then return 0; fi
  done
  local cfg="${LEANCLI_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/leancli/daemon.json}"
  if [[ -f "$cfg" ]]; then
    # rpc_url / rpcUrl / rpc_endpoint / rpcEndpoint as a non-empty string.
    if grep -qE '"(rpc_url|rpcUrl|rpc_endpoint|rpcEndpoint)"[[:space:]]*:[[:space:]]*"[^"]+' "$cfg" 2>/dev/null; then
      return 0
    fi
    # rpc_urls.<chain> with a non-empty value (string or { url: "..." } object).
    if grep -qE '"rpc_urls"' "$cfg" 2>/dev/null \
       && grep -qE '"(mainnet|sepolia|[a-z0-9_-]+)"[[:space:]]*:[[:space:]]*("[^"]+"|\{[^}]*"url"[[:space:]]*:[[:space:]]*"[^"]+)' "$cfg" 2>/dev/null; then
      return 0
    fi
  fi
  return 1
}

master_init_done() {
  local data="${XDG_DATA_HOME:-$HOME/.local/share}/leancli/wallet/master.json"
  [[ -f "$data" ]]
}

prompt_rpc_setup() {
  echo
  echo "==> RPC endpoint setup"
  echo "  The daemon refuses to start without at least one RPC URL. Configure"
  echo "  mainnet and/or sepolia now (Enter to skip a chain)."
  echo
  local mainnet_url sepolia_url
  read -rp "  Mainnet RPC URL (e.g. https://eth.llamarpc.com): " mainnet_url
  read -rp "  Sepolia RPC URL (e.g. https://sepolia.drpc.org): " sepolia_url

  if [[ -z "${mainnet_url:-}" && -z "${sepolia_url:-}" ]]; then
    echo "  (no URLs entered — set later with: leancli network set-rpc-chain <chain> <url>)"
    return 1
  fi

  local ok=1
  if [[ -n "${mainnet_url:-}" ]]; then
    if "$LEAN_BIN" network set-rpc-chain mainnet "$mainnet_url" >/dev/null; then
      echo "  ✓ mainnet RPC saved"
    else
      echo "  ✗ failed to save mainnet RPC"; ok=0
    fi
  fi
  if [[ -n "${sepolia_url:-}" ]]; then
    if "$LEAN_BIN" network set-rpc-chain sepolia "$sepolia_url" >/dev/null; then
      echo "  ✓ sepolia RPC saved"
    else
      echo "  ✗ failed to save sepolia RPC"; ok=0
    fi
  fi

  local default_chain=""
  if [[ -n "${mainnet_url:-}" ]]; then default_chain=mainnet
  elif [[ -n "${sepolia_url:-}" ]]; then default_chain=sepolia
  fi
  if [[ -n "$default_chain" ]]; then
    "$LEAN_BIN" network set-chain "$default_chain" >/dev/null \
      && echo "  ✓ default chain set to $default_chain"
  fi

  # Mirror the default chain's URL into daemon.env so the systemd unit
  # sees the same RPC config as a shell-launched daemon. Picking the
  # default chain keeps the env file aligned with `leancli network show`.
  local env_url=""
  if [[ "$default_chain" == "mainnet" ]]; then env_url="$mainnet_url"
  elif [[ "$default_chain" == "sepolia" ]]; then env_url="$sepolia_url"
  fi
  if [[ -n "$env_url" ]]; then
    LEANCLI_RPC_URL="$env_url" ensure_daemon_env
  fi

  [[ $ok -eq 1 ]]
}

prompt_master_init() {
  echo
  echo "==> Wallet master passphrase (encryption-at-rest)"
  echo "  One passphrase wraps every EOA seed + the privacy-pool secret. Skipping"
  echo "  means each EOA needs its own per-slot passphrase forever."
  echo
  local choice
  read -rp "  Set up the master passphrase now? [Y/n] " choice
  case "${choice:-y}" in
    [Nn]*)
      echo "  (skipped — set later with: leancli wallet master init)"
      return 0
      ;;
  esac
  # `wallet master init` is interactive: prompts the passphrase twice and,
  # if the TPM is ready, offers an optional TPM PIN (Enter to skip).
  if ! "$LEAN_BIN" wallet master init; then
    echo "leanclispawn: wallet master init failed; retry with \`leancli wallet master init\`" >&2
    return 1
  fi
}

launch_first_run_tui() {
  echo
  echo "==> First-run setup — launching leancli tui"
  echo "  The TUI walks RPC config → master passphrase → main menu."
  echo "  Press q on the main menu (or Esc on any gate) to finish."
  echo
  # The TUI's BootGate routes:
  #   probe wallet.master.status →  transport-err  → RpcSetupGate
  #                              →  !initialized   → MasterInitGate
  #                              →  initialized    → MasterUnlockGate
  # so a fresh install lands in RpcSetupGate, an RPC-only-missing install
  # in RpcSetupGate, an RPC-set-but-no-master install in MasterInitGate,
  # and a fully-set install drops straight to MainMenu. Either way the
  # user only sees the gate(s) that are still needed.
  #
  # We don't fail the install on a non-zero TUI exit — the user may have
  # quit early on purpose, and the post-install message points them at
  # `leancli tui` if they want to come back.
  "$LEAN_BIN" tui || true
}

# Outcome tracking for the post-install footer. We want a green "Installed."
# only when first-run actually completed — anything else (user skipped,
# wizard ran but bailed, daemon failure mid-init) should call out the
# specific missing piece(s) so users don't read "Installed." and assume
# everything works.
#
#   SETUP_ATTEMPTED  1 = wizard ran (TUI or shell). 0 = skipped by flag or non-TTY.
#   has_rpc_configured / master_init_done  re-evaluated after the dispatcher.
SETUP_ATTEMPTED=0

# The wizard needs to talk to a live daemon (`wallet.master.status`,
# `wallet.master.init`). If a marker from a previous install is sitting
# at $LEANCLI_SYSTEMD_MARKER, autospawn would refuse and the wizard would
# stall. Remove the marker for the duration of the wizard; the
# `finalize_systemd_handoff` step at the end of the script will recreate
# it after onboarding finishes (or is skipped).
if [[ -e "$LEANCLI_SYSTEMD_MARKER" ]]; then
  rm -f "$LEANCLI_SYSTEMD_MARKER"
fi

if [[ $RUN_INIT_WIZARD -eq 1 && -t 0 && -t 1 ]]; then
  if has_rpc_configured && master_init_done; then
    echo
    echo "==> First-run setup"
    echo "  ✓ RPC endpoint already configured (\`leancli network show\` to inspect)"
    echo "  ✓ wallet master already initialized"
  elif [[ -f "$TUI_BUNDLE" ]]; then
    SETUP_ATTEMPTED=1
    launch_first_run_tui
  else
    # --no-tui install or build failure: fall back to the shell wizard.
    SETUP_ATTEMPTED=1
    echo
    echo "==> First-run setup (shell mode — TUI bundle unavailable)"
    if has_rpc_configured; then
      echo "  ✓ RPC endpoint already configured (\`leancli network show\` to inspect)"
    else
      prompt_rpc_setup || true
    fi
    if master_init_done; then
      echo "  ✓ wallet master already initialized"
    elif has_rpc_configured; then
      prompt_master_init || true
    else
      echo "  (skipping master passphrase: needs at least one RPC URL first."
      echo "   Run \`leancli network set-rpc-chain mainnet <url>\` then \`leancli wallet master init\`.)"
    fi
  fi
elif [[ $RUN_INIT_WIZARD -eq 0 ]]; then
  echo
  echo "==> First-run setup: skipped (--no-init)"
else
  # Non-TTY path (curl|bash, CI). Don't fail; just point at the manual commands.
  echo
  echo "==> First-run setup: skipped (non-interactive shell)"
  echo "    Run \`leanclispawn\` again from a TTY for the interactive TUI setup,"
  echo "    or configure manually:"
  echo "      leancli network set-rpc-chain mainnet <url>"
  echo "      leancli network set-rpc-chain sepolia <url>"
  echo "      leancli wallet master init"
fi

echo

# ---- systemd handoff -------------------------------------------------------
#
# Onboarding may have autospawned a daemon (and a colibri sidecar with it).
# Now that the wizard is done, hand the daemon's lifecycle over to systemd:
# kill anything still running, drop the marker, and let the post-install
# footer tell the user the exact `systemctl --user start` command.
#
# The marker is the single source of truth for "autospawn off" — both the
# Lean CLI and the TUI's daemon clients check for it before spawning.
# Users who don't have systemd (uncommon on the supported targets) won't
# have systemctl on PATH; we still drop the marker so they get a
# consistent "the CLI no longer autospawns" experience, but we surface a
# fallback hint instead of `systemctl --user start`.
finalize_systemd_handoff() {
  # Kill any autospawned daemon/bridge so systemd's first `start` doesn't
  # race a stale process bound to the same UDS path.
  kill_stale_leancli_processes
  mkdir -p "$LEANCLI_CFG_DIR"
  if [[ ! -e "$LEANCLI_SYSTEMD_MARKER" ]]; then
    : > "$LEANCLI_SYSTEMD_MARKER"
    echo "==> $LEANCLI_SYSTEMD_MARKER (autospawn disabled — daemon is managed by systemd)"
  fi
}

# Restart leancli-daemon and/or leancli-agentd if --restart was passed AND
# the unit is currently active. Avoids starting a daemon the user
# intentionally stopped. Quiet pass-through on hosts without systemctl.
restart_daemons_if_requested() {
  if [[ "$RESTART_DAEMONS" -ne 1 ]]; then return 0; fi
  if ! command -v systemctl >/dev/null 2>&1; then
    echo "leanclispawn: --restart requested but systemctl not on PATH; skipped" >&2
    return 0
  fi
  for unit in leancli-daemon leancli-agentd; do
    if systemctl --user is-active --quiet "$unit" 2>/dev/null; then
      if systemctl --user restart "$unit" 2>/dev/null; then
        echo "==> systemctl --user restart $unit"
      else
        echo "leanclispawn: failed to restart $unit (manual: 'systemctl --user restart $unit')" >&2
      fi
    fi
  done
}

finalize_systemd_handoff
restart_daemons_if_requested

# Footer.
#
# A green "Installed." should mean the wallet is actually ready to use —
# RPC configured AND master passphrase set. If the user attempted the
# first-run wizard but didn't complete it (TUI exited mid-flow, daemon
# error during `wallet master init`, etc.) the trailing message used to
# still read "Installed.", which trained users to ignore the warnings
# scrolled off the top. Now: if anything's missing, the footer leads
# with what to do.
RPC_OK=0
MASTER_OK=0
if has_rpc_configured; then RPC_OK=1; fi
if master_init_done; then MASTER_OK=1; fi

print_systemd_hint() {
  if command -v systemctl >/dev/null 2>&1; then
    echo
    echo "Daemon lifecycle (systemd user unit, manual start only):"
    echo "  systemctl --user start leancli-daemon       # launch the daemon"
    echo "  systemctl --user status leancli-daemon      # check it's healthy"
    echo "  journalctl --user -u leancli-daemon -f      # tail logs"
    echo "  systemctl --user stop leancli-daemon        # shut it down"
  else
    echo
    echo "Note: systemctl was not on PATH at install time; the leancli-daemon"
    echo "unit was copied to $SYSTEMD_UNIT_PATH but cannot be started here."
    echo "Either install systemd or remove $LEANCLI_SYSTEMD_MARKER to re-enable"
    echo "the CLI/TUI's autospawn behavior."
  fi
}

print_path_hint() {
  case ":${PATH:-}:" in
    *":$LEANCLI_BIN:"*) ;;
    *)
      if [[ $MODIFY_PATH -eq 1 ]]; then
        echo "  (restart your shell or 'source $(pick_rc)' to pick up PATH)"
      else
        echo "  (add $LEANCLI_BIN to your PATH first)"
      fi
      ;;
  esac
}

if [[ $RPC_OK -eq 1 && $MASTER_OK -eq 1 ]]; then
  echo "Installed. Try:"
  print_path_hint
  echo "  leancli help"
  echo "  leancli tui"
  print_systemd_hint
  echo
  echo "To update later:  leanclispawn --pull"
elif [[ $SETUP_ATTEMPTED -eq 1 ]]; then
  # Wizard ran but at least one step didn't land. Lead with the missing
  # piece so it doesn't get lost above the "Installed" line.
  echo "Installed, but first-run setup is incomplete:"
  if [[ $RPC_OK -eq 0 ]]; then
    echo "  ✗ no RPC URL configured — daemon will refuse to start"
    echo "      leancli network set-rpc-chain mainnet <url>"
  else
    echo "  ✓ RPC URL configured"
  fi
  if [[ $MASTER_OK -eq 0 ]]; then
    echo "  ✗ wallet master not initialized — EOA seeds will need per-slot passphrases"
    echo "      leancli wallet master init   (or relaunch \`leancli tui\`)"
  else
    echo "  ✓ wallet master initialized"
  fi
  print_path_hint
  print_systemd_hint
  echo
  echo "Re-run \`leanclispawn\` to retry the setup wizard."
else
  # --no-init or non-TTY: the dispatcher already printed the manual
  # commands. Keep the footer minimal so it doesn't compete with that.
  echo "Installed under $LEANCLI_BIN."
  print_path_hint
  echo
  echo "Try:"
  echo "  leancli help"
  echo "  leancli tui"
  print_systemd_hint
  echo
  echo "To update later:  leanclispawn --pull"
fi
