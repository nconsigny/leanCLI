{
  "$schema": "../../specs/erc7730-v2.schema.json",
  "context": {
    "contract": {
      "deployments": [
        { "chainId": 1, "address": "0xAD9A0E7C08bc9F747dF97a3E7E7f620632CB6155" }
      ]
    }
  },
  "metadata": {
    "owner": "f(x) Protocol — wstETH market",
    "info": { "url": "https://docs.aladdin.club/fx-protocol/" },
    "constants": {
      "baseToken":      "0x7f39c581f595b53c5cb19bd0b3f8da6c935e2ca0",
      "fToken":         "0x085780639CC2cACd35E474e71f4d000e2405d8f6",
      "xToken":         "0xD6B8162e2fb9F3EFf09bb8598ca0C8958E33A23D",
      "baseTicker":     "wstETH",
      "fTicker":        "fxUSD",
      "xTicker":        "xstETH"
    }
  },
  "display": {
    "formats": {
      "mintFToken(uint256 baseIn,address recipient,uint256 minFTokenMinted)": {
        "intent": "Mint fxUSD with wstETH",
        "fields": [
          { "label": "Collateral in",  "format": "tokenAmount", "params": { "token": "$.metadata.constants.baseToken" }, "path": "#.baseIn", "visible": "always" },
          { "label": "fxUSD recipient", "format": "addressName", "params": { "types": ["eoa", "wallet"] }, "path": "#.recipient", "visible": "always" },
          { "label": "Min fxUSD out",   "format": "tokenAmount", "params": { "token": "$.metadata.constants.fToken" }, "path": "#.minFTokenMinted", "visible": "always" }
        ]
      },
      "mintXToken(uint256 baseIn,address recipient,uint256 minXTokenMinted)": {
        "intent": "Mint xstETH (leveraged ETH) with wstETH",
        "fields": [
          { "label": "Collateral in",   "format": "tokenAmount", "params": { "token": "$.metadata.constants.baseToken" }, "path": "#.baseIn", "visible": "always" },
          { "label": "xstETH recipient", "format": "addressName", "params": { "types": ["eoa", "wallet"] }, "path": "#.recipient", "visible": "always" },
          { "label": "Min xstETH out",   "format": "tokenAmount", "params": { "token": "$.metadata.constants.xToken" }, "path": "#.minXTokenMinted", "visible": "always" }
        ]
      },
      "redeemFToken(uint256 fTokenIn,address recipient,uint256 minBaseOut)": {
        "intent": "Redeem fxUSD for wstETH",
        "fields": [
          { "label": "fxUSD in",          "format": "tokenAmount", "params": { "token": "$.metadata.constants.fToken" }, "path": "#.fTokenIn", "visible": "always" },
          { "label": "Collateral recipient","format": "addressName", "params": { "types": ["eoa", "wallet"] }, "path": "#.recipient", "visible": "always" },
          { "label": "Min wstETH out",    "format": "tokenAmount", "params": { "token": "$.metadata.constants.baseToken" }, "path": "#.minBaseOut", "visible": "always" }
        ]
      },
      "redeemXToken(uint256 xTokenIn,address recipient,uint256 minBaseOut)": {
        "intent": "Redeem xstETH for wstETH",
        "fields": [
          { "label": "xstETH in",         "format": "tokenAmount", "params": { "token": "$.metadata.constants.xToken" }, "path": "#.xTokenIn", "visible": "always" },
          { "label": "Collateral recipient","format": "addressName", "params": { "types": ["eoa", "wallet"] }, "path": "#.recipient", "visible": "always" },
          { "label": "Min wstETH out",    "format": "tokenAmount", "params": { "token": "$.metadata.constants.baseToken" }, "path": "#.minBaseOut", "visible": "always" }
        ]
      }
    }
  }
}
