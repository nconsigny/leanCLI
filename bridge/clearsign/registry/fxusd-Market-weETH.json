{
  "$schema": "../../specs/erc7730-v2.schema.json",
  "context": {
    "contract": {
      "deployments": [
        {
          "chainId": 1,
          "address": "0x267C6A96Db7422faA60Aa7198FfEeeC4169CD65f"
        }
      ]
    }
  },
  "metadata": {
    "owner": "f(x) Protocol \u2014 weETH market",
    "info": {
      "url": "https://docs.aladdin.club/fx-protocol/"
    },
    "constants": {
      "baseToken": "0xcd5fe23c85820f7b72d0926fc9b05b43e359b7ee",
      "fToken": "0x085780639CC2cACd35E474e71f4d000e2405d8f6",
      "xToken": "0xACB3604AaDF26e6C0bb8c720420380629A328d2C",
      "baseTicker": "weETH",
      "fTicker": "fxUSD",
      "xTicker": "xeETH"
    }
  },
  "display": {
    "formats": {
      "mintFToken(uint256 baseIn,address recipient,uint256 minFTokenMinted)": {
        "intent": "Mint fxUSD with weETH",
        "fields": [
          {
            "label": "Collateral in",
            "format": "tokenAmount",
            "params": {
              "token": "$.metadata.constants.baseToken"
            },
            "path": "#.baseIn",
            "visible": "always"
          },
          {
            "label": "fxUSD recipient",
            "format": "addressName",
            "params": {
              "types": [
                "eoa",
                "wallet"
              ]
            },
            "path": "#.recipient",
            "visible": "always"
          },
          {
            "label": "Min fxUSD out",
            "format": "tokenAmount",
            "params": {
              "token": "$.metadata.constants.fToken"
            },
            "path": "#.minFTokenMinted",
            "visible": "always"
          }
        ]
      },
      "mintXToken(uint256 baseIn,address recipient,uint256 minXTokenMinted)": {
        "intent": "Mint xeETH (leveraged ETH) with weETH",
        "fields": [
          {
            "label": "Collateral in",
            "format": "tokenAmount",
            "params": {
              "token": "$.metadata.constants.baseToken"
            },
            "path": "#.baseIn",
            "visible": "always"
          },
          {
            "label": "xeETH recipient",
            "format": "addressName",
            "params": {
              "types": [
                "eoa",
                "wallet"
              ]
            },
            "path": "#.recipient",
            "visible": "always"
          },
          {
            "label": "Min xeETH out",
            "format": "tokenAmount",
            "params": {
              "token": "$.metadata.constants.xToken"
            },
            "path": "#.minXTokenMinted",
            "visible": "always"
          }
        ]
      },
      "redeemFToken(uint256 fTokenIn,address recipient,uint256 minBaseOut)": {
        "intent": "Redeem fxUSD for weETH",
        "fields": [
          {
            "label": "fxUSD in",
            "format": "tokenAmount",
            "params": {
              "token": "$.metadata.constants.fToken"
            },
            "path": "#.fTokenIn",
            "visible": "always"
          },
          {
            "label": "Collateral recipient",
            "format": "addressName",
            "params": {
              "types": [
                "eoa",
                "wallet"
              ]
            },
            "path": "#.recipient",
            "visible": "always"
          },
          {
            "label": "Min weETH out",
            "format": "tokenAmount",
            "params": {
              "token": "$.metadata.constants.baseToken"
            },
            "path": "#.minBaseOut",
            "visible": "always"
          }
        ]
      },
      "redeemXToken(uint256 xTokenIn,address recipient,uint256 minBaseOut)": {
        "intent": "Redeem xeETH for weETH",
        "fields": [
          {
            "label": "xeETH in",
            "format": "tokenAmount",
            "params": {
              "token": "$.metadata.constants.xToken"
            },
            "path": "#.xTokenIn",
            "visible": "always"
          },
          {
            "label": "Collateral recipient",
            "format": "addressName",
            "params": {
              "types": [
                "eoa",
                "wallet"
              ]
            },
            "path": "#.recipient",
            "visible": "always"
          },
          {
            "label": "Min weETH out",
            "format": "tokenAmount",
            "params": {
              "token": "$.metadata.constants.baseToken"
            },
            "path": "#.minBaseOut",
            "visible": "always"
          }
        ]
      }
    }
  }
}
