{
  "$schema": "../../specs/erc7730-v2.schema.json",
  "context": {
    "contract": {
      "deployments": [
        { "chainId": 1, "address": "0x4231ec00A82Bdd00F7dC9B2D3aA01fF8E51fb01e" }
      ]
    }
  },
  "metadata": {
    "owner": "Liquity V2 (BOLD)",
    "info": { "url": "https://docs.liquity.org" }
  },
  "display": {
    "formats": {
      "openTrove(address _owner,uint256 _ownerIndex,uint256 _ETHAmount,uint256 _boldAmount,uint256 _upperHint,uint256 _lowerHint,uint256 _annualInterestRate,uint256 _maxUpfrontFee,address _addManager,address _removeManager,address _receiver)": {
        "intent": "Open Liquity V2 trove (borrow BOLD against ETH)",
        "fields": [
          { "label": "Owner",           "format": "addressName", "params": { "types": ["wallet", "eoa"] }, "path": "#._owner", "visible": "always" },
          { "label": "Trove sub-index", "format": "raw", "path": "#._ownerIndex" },
          { "label": "Collateral (ETH base units)", "format": "raw", "path": "#._ETHAmount", "visible": "always" },
          { "label": "Debt (BOLD base units)",       "format": "raw", "path": "#._boldAmount", "visible": "always" },
          { "label": "Annual interest rate (1e18=100%)", "format": "raw", "path": "#._annualInterestRate", "visible": "always" },
          { "label": "Max upfront fee", "format": "raw", "path": "#._maxUpfrontFee" },
          { "label": "Add-collateral manager",    "format": "addressName", "params": { "types": ["wallet", "eoa", "contract"] }, "path": "#._addManager" },
          { "label": "Remove-collateral manager", "format": "addressName", "params": { "types": ["wallet", "eoa", "contract"] }, "path": "#._removeManager" },
          { "label": "BOLD receiver", "format": "addressName", "params": { "types": ["wallet", "eoa"] }, "path": "#._receiver" }
        ]
      },
      "closeTrove(uint256 _troveId)": {
        "intent": "Close Liquity V2 trove (repay debt + reclaim collateral)",
        "fields": [
          { "label": "Trove ID", "format": "raw", "path": "#._troveId", "visible": "always" }
        ]
      },
      "adjustTrove(uint256 _troveId,uint256 _collChange,bool _isCollIncrease,uint256 _debtChange,bool isDebtIncrease,uint256 _maxUpfrontFee)": {
        "intent": "Adjust Liquity V2 trove",
        "fields": [
          { "label": "Trove ID",          "format": "raw", "path": "#._troveId",        "visible": "always" },
          { "label": "Collateral change", "format": "raw", "path": "#._collChange",     "visible": "always" },
          { "label": "Collateral increase?", "format": "raw", "path": "#._isCollIncrease", "visible": "always" },
          { "label": "Debt change",       "format": "raw", "path": "#._debtChange",     "visible": "always" },
          { "label": "Debt increase?",    "format": "raw", "path": "#.isDebtIncrease",  "visible": "always" },
          { "label": "Max upfront fee",   "format": "raw", "path": "#._maxUpfrontFee" }
        ]
      },
      "addColl(uint256 _troveId,uint256 _ETHAmount)": {
        "intent": "Top up Liquity V2 trove collateral",
        "fields": [
          { "label": "Trove ID",  "format": "raw", "path": "#._troveId",  "visible": "always" },
          { "label": "Add (ETH)", "format": "raw", "path": "#._ETHAmount","visible": "always" }
        ]
      },
      "withdrawColl(uint256 _troveId,uint256 _amount)": {
        "intent": "Withdraw collateral from Liquity V2 trove",
        "fields": [
          { "label": "Trove ID",       "format": "raw", "path": "#._troveId", "visible": "always" },
          { "label": "Withdraw (ETH)", "format": "raw", "path": "#._amount",  "visible": "always" }
        ]
      },
      "withdrawBold(uint256 _troveId,uint256 _amount,uint256 _maxUpfrontFee)": {
        "intent": "Borrow more BOLD from Liquity V2 trove",
        "fields": [
          { "label": "Trove ID",      "format": "raw", "path": "#._troveId",      "visible": "always" },
          { "label": "Amount (BOLD)", "format": "raw", "path": "#._amount",       "visible": "always" },
          { "label": "Max upfront fee","format": "raw", "path": "#._maxUpfrontFee" }
        ]
      },
      "repayBold(uint256 _troveId,uint256 _amount)": {
        "intent": "Repay BOLD on Liquity V2 trove",
        "fields": [
          { "label": "Trove ID",      "format": "raw", "path": "#._troveId", "visible": "always" },
          { "label": "Amount (BOLD)", "format": "raw", "path": "#._amount",  "visible": "always" }
        ]
      },
      "claimCollateral()": {
        "intent": "Claim post-liquidation surplus collateral",
        "fields": []
      }
    }
  }
}
